          "type": "slide",
          "settings": {
            "eyebrow": "Winter 26",
            "heading": "Nine dips of indigo",
            "subheading": "dried in the Rajasthan sun",
            "text": "<p>Every length is dipped by hand, oxidised in the open, and signed by the printer.</p>",
