{%- comment -%}
  Price renderer. Params:
    product    – product object (required)
    variant    – optional variant, overrides product prices
    class      – extra classes
    show_badge – show the percentage-off tag
    show_unit  – show unit price when available
    use_ids    – add data-price-* hooks so theme.js can update it live
{%- endcomment -%}
{%- liquid
  assign p = product
  assign v = variant
  assign price = p.price
  assign compare = p.compare_at_price
  assign varies = p.price_varies
  if v != nil
    assign price = v.price
    assign compare = v.compare_at_price
    assign varies = false
  endif
  assign on_sale = false
  if compare != blank and compare > price
    assign on_sale = true
  endif
  assign hooks = ''
  if use_ids
    assign hooks = ' data-price'
  endif
-%}
<div class="price {{ class }}{% if on_sale %} price--sale{% endif %}"{{ hooks }}>
  <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>

  {%- if varies and v == nil -%}
    {%- assign from_price = p.price_min | money -%}
    {%- if settings.currency_code_enable -%}{%- assign from_price = p.price_min | money_with_currency -%}{%- endif -%}
    <span class="price__current"{% if use_ids %} data-price-current{% endif %}>
      {{ 'products.product.price.from_price_html' | t: price: from_price }}
    </span>
  {%- else -%}
    {%- if settings.currency_code_enable -%}
      {%- assign price_str = price | money_with_currency -%}
      {%- assign compare_str = compare | money_with_currency -%}
    {%- else -%}
      {%- assign price_str = price | money -%}
      {%- assign compare_str = compare | money -%}
    {%- endif -%}
    <span class="price__current{% if on_sale %} price__sale{% endif %}"{% if use_ids %} data-price-current{% endif %}>{{ price_str }}</span>
  {%- endif -%}

  {%- if on_sale -%}
    <s class="price__compare"{% if use_ids %} data-price-compare{% endif %}>{{ compare_str }}</s>
    {%- if show_badge -%}
      {%- assign saved = compare | minus: price | times: 100.0 | divided_by: compare | round -%}
      <span class="price__badge">&minus;{{ saved }}%</span>
    {%- endif -%}
  {%- elsif use_ids -%}
    <span class="price__compare" data-price-compare hidden></span>
  {%- endif -%}

  {%- if show_unit -%}
    {%- assign unit_variant = v | default: p.selected_or_first_available_variant -%}
    {%- if unit_variant.unit_price_measurement -%}
      <span class="price__unit"{% if use_ids %} data-unit-price{% endif %}>
        {{ unit_variant.unit_price | money }}
        <span>{{ 'general.accessibility.unit_price_separator' | t }}</span>
        {%- if unit_variant.unit_price_measurement.reference_value != 1 -%}
          {{ unit_variant.unit_price_measurement.reference_value }}
        {%- endif -%}
        {{ unit_variant.unit_price_measurement.reference_unit }}
      </span>
    {%- elsif use_ids -%}
      <span class="price__unit" data-unit-price hidden></span>
    {%- endif -%}
  {%- endif -%}
</div>
