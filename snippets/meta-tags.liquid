{%- comment -%}
  Meta description + Open Graph / Twitter tags.
  Rendered from layout/theme.liquid.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  case request.page_type
    when 'product'
      assign og_type = 'product'
      if product.description != blank
        assign og_description = product.description | strip_html | truncatewords: 40
      endif
    when 'article'
      assign og_type = 'article'
      if article.excerpt_or_content != blank
        assign og_description = article.excerpt_or_content | strip_html | truncatewords: 40
      endif
    when 'collection'
      assign og_type = 'product.group'
      if collection.description != blank
        assign og_description = collection.description | strip_html | truncatewords: 40
      endif
    when 'password'
      assign og_title = shop.name
      assign og_description = shop.description | default: shop.name
  endcase

  assign og_image = settings.default_social_image
  case request.page_type
    when 'product'
      if product.featured_image != blank
        assign og_image = product.featured_image
      endif
    when 'collection'
      if collection.featured_image != blank
        assign og_image = collection.featured_image
      endif
    when 'article'
      if article.image != blank
        assign og_image = article.image
      endif
    when 'page'
      if page.image != blank
        assign og_image = page.image
      endif
  endcase
-%}

<meta name="description" content="{{ og_description | escape }}">

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if og_image != blank -%}
  <meta property="og:image" content="http:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  {%- if og_image.alt != blank -%}
    <meta property="og:image:alt" content="{{ og_image.alt | escape }}">
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- elsif request.page_type == 'article' -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  <meta property="article:author" content="{{ article.author | escape }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image != blank -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif -%}

{%- if request.page_type == 'article' -%}
  <link rel="alternate" type="application/atom+xml" title="{{ blog.title | escape }}" href="{{ blog.url }}.atom">
{%- endif -%}

{%- if settings.type_header_custom_family == blank and settings.type_body_custom_family == blank -%}
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
{%- endif -%}
