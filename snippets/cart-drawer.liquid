{%- comment -%}
  AJAX cart drawer. Rendered once from layout/theme.liquid.
  The item markup mirrors the row built by Cart.render() in assets/theme.js so
  the server-rendered state and the client-rendered state look identical.
{%- endcomment -%}
{%- if settings.cart_type != 'page' -%}
  {%- liquid
    assign threshold = settings.cart_free_shipping_threshold | default: 0
    assign show_bar = false
    if threshold > 0
      assign show_bar = true
      assign threshold_cents = threshold | times: 100
      assign remaining = threshold_cents | minus: cart.total_price
      if remaining < 0
        assign remaining = 0
      endif
      if cart.total_price > 0 and threshold_cents > 0
        assign percent = cart.total_price | times: 100 | divided_by: threshold_cents
      else
        assign percent = 0
      endif
      if percent > 100
        assign percent = 100
      endif
    endif

    assign empty_heading = settings.cart_empty_heading
    if empty_heading == blank
      assign empty_heading = 'cart.general.empty' | t
    endif
    assign empty_text = settings.cart_empty_text
    if empty_text == blank
      assign empty_text = 'cart.general.empty_text' | t
    endif

    capture empty_state
      echo '<div class="cart-drawer__empty">'
      echo '<span class="cart-drawer__empty-icon">'
      render 'icon', name: 'bag', size: 38
      echo '</span>'
      echo '<p class="h3">'
      echo empty_heading | escape
      echo '</p>'
      echo '<div class="rte text-muted">'
      echo empty_text
      echo '</div>'
      echo '<button type="button" class="btn btn--outline" data-panel-close>'
      echo 'general.continue_shopping' | t
      echo '</button>'
      echo '</div>'
    endcapture
  -%}
  <div
    class="drawer cart-drawer color-scheme-1"
    id="CartDrawer"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'cart.general.title' | t }}"
    aria-hidden="true"
    tabindex="-1"
  >
    <div class="drawer__header">
      <span class="drawer__title">
        {{ 'cart.general.title' | t }}
        <span class="cart-drawer__count" data-cart-count-text>({{ cart.item_count }})</span>
      </span>
      <button type="button" class="drawer__close" data-panel-close aria-label="{{ 'general.accessibility.close' | t }}">
        {%- render 'icon', name: 'close', size: 20 -%}
      </button>
    </div>

    <div class="drawer__body">
      {%- if show_bar -%}
        <div class="ship-bar" data-shipping-bar>
          <p class="ship-bar__text" data-shipping-text>
            {%- if remaining > 0 -%}
              {{ 'cart.general.free_shipping_remaining' | t | replace: '[amount]', remaining | money }}
            {%- else -%}
              {{ 'cart.general.free_shipping_met' | t }}
            {%- endif -%}
          </p>
          <div class="ship-bar__track"><span class="ship-bar__fill" data-shipping-fill style="width: {{ percent }}%"></span></div>
        </div>
      {%- endif -%}

      <div class="cart-drawer__items" data-cart-items>
        {%- if cart.item_count == 0 -%}
          {{ empty_state }}
        {%- else -%}
          {%- for item in cart.items -%}
            {%- render 'cart-item', item: item -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="cart-drawer__empty-template" data-cart-empty hidden>{{ empty_state }}</div>

      <p class="cart-drawer__errors form-message form-message--error" data-cart-errors hidden></p>
    </div>

    <div class="drawer__footer">
      <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm" novalidate>
        {%- if settings.cart_notes -%}
          <details class="cart-note">
            <summary class="cart-note__summary">
              {%- render 'icon', name: 'brush', size: 15 -%}
              <span>{{ 'cart.general.add_note' | t }}</span>
              {%- render 'icon', name: 'chevron-down', size: 14 -%}
            </summary>
            <textarea
              class="cart-note__input"
              name="note"
              id="CartDrawerNote"
              data-cart-note
              placeholder="{{ 'cart.general.note_placeholder' | t }}"
            >{{ cart.note }}</textarea>
          </details>
        {%- endif -%}

        {%- if settings.cart_terms -%}
          <label class="checkbox cart-terms">
            <input type="checkbox" data-cart-terms>
            <span>{{ settings.cart_terms_text }}</span>
          </label>
        {%- endif -%}

        <div class="cart-drawer__totals">
          <span class="cart-drawer__totals-label">{{ 'cart.general.subtotal' | t }}</span>
          <span class="cart-drawer__totals-value" data-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-drawer__savings" hidden>
          {{ 'cart.general.savings' | t }} <strong data-cart-total-savings>{{ 0 | money }}</strong>
        </p>
        <p class="cart-drawer__shipping-note">
          {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
            {{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
          {%- elsif cart.taxes_included -%}
            {{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}
          {%- elsif shop.shipping_policy.body != blank -%}
            {{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
          {%- else -%}
            {{ 'cart.general.shipping_at_checkout' | t }}
          {%- endif -%}
        </p>

        <button
          type="submit"
          name="checkout"
          class="btn btn--full cart-drawer__checkout"
          data-cart-checkout="form"
          {% if cart.item_count == 0 %}disabled{% endif %}
        >
          <span data-btn-label>{{ 'cart.general.checkout' | t }}</span>
          {%- render 'icon', name: 'lock', size: 15 -%}
        </button>

        <a class="cart-drawer__view-cart" href="{{ routes.cart_url }}">{{ 'cart.general.view_cart' | t }}</a>
      </form>
    </div>
  </div>
{%- endif -%}
