{%- comment -%}
  Generates the CSS custom properties for every colour scheme defined in
  Theme settings -> Colours — Scheme 1..6. Rendered inside a <style> tag in
  layout/theme.liquid. Scheme 1 is also mirrored onto :root so the whole
  document has a sane default palette.
{%- endcomment -%}
/* Default palette (scheme 1 — Ivory) */
:root, .color-scheme-1 {
  --bg: {{ settings.color_scheme_1_bg }};
  --bg-rgb: {{ settings.color_scheme_1_bg.red }}, {{ settings.color_scheme_1_bg.green }}, {{ settings.color_scheme_1_bg.blue }};
  --text: {{ settings.color_scheme_1_text }};
  --text-rgb: {{ settings.color_scheme_1_text.red }}, {{ settings.color_scheme_1_text.green }}, {{ settings.color_scheme_1_text.blue }};
  --accent: {{ settings.color_scheme_1_accent }};
  --accent-rgb: {{ settings.color_scheme_1_accent.red }}, {{ settings.color_scheme_1_accent.green }}, {{ settings.color_scheme_1_accent.blue }};
  --on-accent: {{ settings.color_scheme_1_accent_text }};
  --on-accent-rgb: {{ settings.color_scheme_1_accent_text.red }}, {{ settings.color_scheme_1_accent_text.green }}, {{ settings.color_scheme_1_accent_text.blue }};
  --soft: {{ settings.color_scheme_1_soft }};
  --soft-rgb: {{ settings.color_scheme_1_soft.red }}, {{ settings.color_scheme_1_soft.green }}, {{ settings.color_scheme_1_soft.blue }};
  --border: {{ settings.color_scheme_1_border }};
  --border-rgb: {{ settings.color_scheme_1_border.red }}, {{ settings.color_scheme_1_border.green }}, {{ settings.color_scheme_1_border.blue }};
  --text-muted: rgba(var(--text-rgb), 0.66);
  --text-faint: rgba(var(--text-rgb), 0.44);
  --border-soft: rgba(var(--border-rgb), 0.62);
  --surface-tint: rgba(var(--text-rgb), 0.04);
  --hover-tint: rgba(var(--text-rgb), 0.06);
}
