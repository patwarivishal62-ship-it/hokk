      "blocks": {
        "cell-1": {
          "type": "cell",
          "settings": {
            "label": "Region",
            "title": "Pochampally, Telangana",
            "text": "A village whose name is now synonymous with the double-ikat weave."
          }
        },
        "cell-2": {
          "type": "cell",
          "settings": {
            "label": "Technique",
            "title": "Ikat \u2014 Resist-Dyed Yarn",
            "text": "Threads are tie-dyed before weaving, so the pattern lives inside the yarn itself."
          }
        },
        "cell-3": {
          "type": "cell",
          "settings": {
            "label": "Motif",
            "title": "The Diamond Chowka",
            "text": "A geometric motif once reserved for temple textiles, now a print for the everyday."
          }
        },
        "cell-4": {
          "type": "cell",
          "settings": {
            "label": "Reimagined as",
            "title": "Shirts, Co-ords & Jackets",
            "text": "Cut into relaxed silhouettes that move with your day, not against it."
          }
        }
