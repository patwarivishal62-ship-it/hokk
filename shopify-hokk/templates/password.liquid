<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_base }}">
    <title>{{ shop.name | escape }}</title>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="password-page">
    <main class="password-page__main" role="main">
      <div class="password-page__inner">
        <span class="wordmark">
          <span class="wordmark__top">House of</span>
          <span class="wordmark__name">Kala Katha</span>
        </span>
        <h1 class="password-page__title">Coming soon</h1>
        <p class="password-page__text">We're weaving something new. Enter the password to preview the house.</p>

        {%- form 'storefront_password', class: 'password-page__form' -%}
          {%- if form.errors -%}
            <p class="password-page__error">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <input type="password" name="password" placeholder="Password" required>
          <button type="submit" class="btn btn--solid">Enter</button>
        {%- endform -%}

        <p class="password-page__admin">Store owner? <a href="/admin" target="_blank">Log in here</a></p>
      </div>
    </main>
  </body>
</html>
