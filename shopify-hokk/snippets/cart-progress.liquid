{%- comment -%}
  Free shipping progress bar. Reads the global theme setting
  `settings.free_shipping_threshold` (in rupees) and the current cart total.
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
-%}
{%- if threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
    assign remaining = threshold | minus: cart.total_price
    assign remaining_money = remaining | money
  -%}
  <div class="cart-progress">
    {%- if remaining > 0 -%}
      <p class="cart-progress__label">{{ 'cart.general.free_shipping_remaining' | t: amount: remaining_money }}</p>
    {%- else -%}
      <p class="cart-progress__label cart-progress__label--unlocked">{{ 'cart.general.free_shipping_unlocked' | t }}</p>
    {%- endif -%}
    <div class="cart-progress__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}">
      <div class="cart-progress__fill" style="width: {{ pct }}%;"></div>
    </div>
  </div>
{%- endif -%}
