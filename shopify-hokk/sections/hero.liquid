{%- liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
  assign tone = section.settings.tone
-%}

<div class="hero hero--{{ section.settings.height }} hero--{{ tone }} hero--align-{{ section.settings.alignment }}" data-reveal>
  <div class="hero__media">
    {%- if image != blank -%}
      {%- if image_mobile != blank -%}
        {{ image_mobile | image_url: width: 1200 | image_tag:
          loading: 'eager',
          widths: '540, 720, 900, 1080, 1296, 1512',
          class: 'hero__img hero__img--mobile',
          alt: image.alt | escape
        }}
      {%- endif -%}
      {{ image | image_url: width: 2400 | image_tag:
        loading: 'eager',
        widths: '750, 900, 1080, 1296, 1512, 1728, 2048',
        class: 'hero__img',
        alt: image.alt | escape
      }}
    {%- else -%}
      <img src="{{ 'hero.jpg' | asset_url }}" alt="House of Kala Katha handloom co-ord" class="hero__img" loading="eager" width="1200" height="1600">
    {%- endif -%}
    {%- if section.settings.overlay_opacity > 0 -%}
      <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
    {%- endif -%}
  </div>

  <div class="hero__content container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
      <div class="hero__actions">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}" class="btn btn--{{ section.settings.button_style_1 }}">
            {{ section.settings.button_label_1 | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="btn btn--{{ section.settings.button_style_2 }}">
            {{ section.settings.button_label_2 | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_scroll -%}
    <div class="hero__scroll" aria-hidden="true">
      <span>Scroll</span>
      {%- render 'icon', icon: 'arrow-down' -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (optional)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Text tone",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "KALA · CRAFT   —   KATHA · STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Indian Craft.\nEveryday Life."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Why isn't this already in your wardrobe?"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Button 1 label",
      "default": "Explore the Wardrobe"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Button 1 link"
    },
    {
      "type": "select",
      "id": "button_style_1",
      "label": "Button 1 style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button 2 label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button 2 link"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "label": "Button 2 style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "outline"
    },
    {
      "type": "checkbox",
      "id": "show_scroll",
      "label": "Show scroll indicator",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
