<div class="account">
  <div class="container">
    <h1 class="section-title">{{ 'customer.account.hello' | t: name: customer.name }}</h1>

    <div class="account__grid">
      <section class="account__orders">
        <div class="account__section-head">
          <h2>{{ 'customer.account.orders_title' | t }}</h2>
          <a href="{{ routes.account_logout_url }}" class="btn btn--text">{{ 'customer.account.logout' | t }}</a>
        </div>

        {%- if customer.orders.size > 0 -%}
          <table class="account__table">
            <thead>
              <tr>
                <th>{{ 'customer.account.order_number' | t }}</th>
                <th>{{ 'customer.account.date' | t }}</th>
                <th>{{ 'customer.account.payment_status' | t }}</th>
                <th>{{ 'customer.account.fulfillment_status' | t }}</th>
                <th>{{ 'customer.account.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%d %b %Y' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p>{{ 'customer.account.no_orders' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--solid">{{ 'general.continue_shopping' | t }}</a>
        {%- endif -%}
      </section>

      <section class="account__address">
        <div class="account__section-head">
          <h2>{{ 'customer.account.addresses_title' | t }}</h2>
          <a href="{{ routes.account_addresses_url }}" class="btn btn--text">{{ 'customer.account.view_addresses' | t }}</a>
        </div>
        {%- if customer.default_address -%}
          <div class="account__address-card">
            {{ customer.default_address | format_address }}
          </div>
        {%- endif -%}
      </section>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Account",
  "class": "section-account",
  "settings": []
}
{% endschema %}
