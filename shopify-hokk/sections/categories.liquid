<div class="categories categories--align-{{ section.settings.text_alignment }}" data-reveal style="--section-pad-top: {{ section.settings.padding_top }}px; --section-pad-bottom: {{ section.settings.padding_bottom }}px; --cat-img-ratio: {{ section.settings.image_ratio }}; --cat-img-radius: {{ section.settings.image_radius }}px; {% if section.settings.background_color != blank %}--sec-bg: {{ section.settings.background_color }};{% endif %}{% if section.settings.text_color != blank %}--sec-text: {{ section.settings.text_color }};{% endif %}--cat-gap: {{ section.settings.gap }}px;">
    {%- render 'section-background', bg_video: section.settings.background_video, bg_image: section.settings.background_image -%}

  <div class="container">
    <div class="categories__head" style="--text-width: {{ section.settings.text_width }}px">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow"{% if section.settings.eyebrow_color != blank %} style="color: {{ section.settings.eyebrow_color }};"{% endif %}>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title"{% if section.settings.heading_color != blank %} style="color: {{ section.settings.heading_color }};"{% endif %}>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="categories__subheading"{% if section.settings.subheading_color != blank %} style="color: {{ section.settings.subheading_color }};"{% endif %}>{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- assign category_fallbacks = 'category-shirts.jpg|category-jackets.jpg|lookbook-1.jpg|lookbook-2.jpg' | split: '|' -%}
    <div class="categories__grid categories__grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign image = block.settings.image
          assign title = block.settings.title
          if title == blank and collection != blank
            assign title = collection.title
          endif
          assign caption = block.settings.caption
          assign url = '#'
          if collection != blank
            assign url = collection.url
          endif
        -%}
        <a href="{{ url }}" class="category-card" {{ block.shopify_attributes }}>
          <div class="category-card__media">
            {%- if image != blank -%}
              {{ image | image_url: width: 900 | image_tag:
                loading: 'lazy',
                widths: '360, 540, 720, 900',
                class: 'category-card__img',
                alt: title | escape
              }}
            {%- elsif collection != blank and collection.featured_image != blank -%}
              {{ collection.featured_image | image_url: width: 900 | image_tag:
                loading: 'lazy',
                widths: '360, 540, 720, 900',
                class: 'category-card__img',
                alt: title | escape
              }}
            {%- else -%}
              {%- assign cf_idx = forloop.index0 | modulo: category_fallbacks.size -%}
              <img src="{{ category_fallbacks[cf_idx] | asset_url }}" alt="{{ title | escape }}" class="category-card__img" loading="lazy" width="600" height="800">
            {%- endif -%}
          </div>
          <div class="category-card__info">
            {%- if caption != blank -%}
              <span class="category-card__caption"{% if section.settings.caption_color != blank %} style="color: {{ section.settings.caption_color }};"{% endif %}>{{ caption | escape }}</span>
            {%- endif -%}
            <span class="category-card__title"{% if section.settings.title_color != blank %} style="color: {{ section.settings.title_color }};"{% endif %}>{{ title | escape }}</span>
            <span class="category-card__arrow">{%- render 'icon', icon: 'arrow-right' -%}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

