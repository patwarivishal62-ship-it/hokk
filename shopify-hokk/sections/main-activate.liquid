<div class="account-auth">
  <div class="container">
    <div class="account-auth__inner">
      <h1 class="section-title">{{ 'customer.activate_account.title' | t }}</h1>
      <p>Create your password to activate your account.</p>

      {%- form 'activate_customer_password', class: 'auth-form' -%}
        {%- if form.errors -%}
          <p class="auth-form__error" role="alert">
            {%- render 'icon', icon: 'error' -%}
            {{ form.errors | default_errors }}
          </p>
        {%- endif -%}

        <label>
          <span>Password</span>
          <input type="password" name="customer[password]" required>
        </label>
        <label>
          <span>Confirm password</span>
          <input type="password" name="customer[password_confirmation]" required>
        </label>
        <button type="submit" class="btn btn--solid btn--full">{{ 'customer.activate_account.submit' | t }}</button>
        <button type="submit" name="decline" class="btn btn--text btn--full">{{ 'customer.activate_account.decline' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Activate account",
  "class": "section-activate-account",
  "settings": []
}
{% endschema %}
