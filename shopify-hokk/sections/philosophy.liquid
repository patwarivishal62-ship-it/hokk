{%- liquid
  assign layout = section.settings.layout
-%}

<div class="philosophy philosophy--{{ layout }} philosophy--align-{{ section.settings.alignment }}" data-reveal style="--section-pad-top: {{ section.settings.padding_top }}px; --section-pad-bottom: {{ section.settings.padding_bottom }}px; --phil-img-ratio: {{ section.settings.image_ratio }}; --phil-img-radius: {{ section.settings.image_radius }}px; {% if section.settings.background_color != blank %}--sec-bg: {{ section.settings.background_color }};{% endif %}{% if section.settings.text_color != blank %}--sec-text: {{ section.settings.text_color }};{% endif %}--phil-gap: {{ section.settings.gap }}px;">
  <div class="container">
    <div class="philosophy__grid">
      <div class="philosophy__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag:
            loading: 'lazy',
            widths: '540, 720, 900, 1080, 1296',
            class: 'philosophy__img',
            alt: section.settings.image.alt | escape
          }}
        {%- else -%}
          <img src="{{ 'craft-loom.jpg' | asset_url }}" alt="Artisan hands weaving on a traditional handloom" class="philosophy__img" loading="lazy" width="1000" height="1250">
        {%- endif -%}
      </div>

      <div class="philosophy__body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow"{% if section.settings.eyebrow_color != blank %} style="color: {{ section.settings.eyebrow_color }};"{% endif %}>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-title"{% if section.settings.heading_color != blank %} style="color: {{ section.settings.heading_color }};"{% endif %}>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte philosophy__text"{% if section.settings.text_color != blank %} style="color: {{ section.settings.text_color }};"{% endif %}>{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.quote != blank -%}
          <blockquote class="philosophy__quote"{% if section.settings.quote_color != blank %} style="color: {{ section.settings.quote_color }};"{% endif %}>{{ section.settings.quote | escape }}</blockquote>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--{{ section.settings.button_style }}">
            {{ section.settings.button_label | escape }}
            {%- render 'icon', icon: 'arrow-right' -%}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}{
  "name": "Philosophy",
  "class": "section-philosophy",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "image-left",
          "label": "Image left"
        },
        {
          "value": "image-right",
          "label": "Image right"
        }
      ],
      "default": "image-left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Kala is the art. Katha is the story."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every House of Kala Katha piece begins its life on a loom, in a village, in the hands of someone who has spent a lifetime perfecting a technique passed down through generations. We take that craft — the ikat, the kalamkari, the patola — and we re-cut it, re-imagine it, re-fit it for the life you actually live.</p>"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "default": "This isn't heritage you wear once a year. This is heritage that belongs in your everyday life."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read the craft stories"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "3/4",
          "label": "Portrait 3:4"
        },
        {
          "value": "4/5",
          "label": "Portrait 4:5"
        },
        {
          "value": "1/1",
          "label": "Square 1:1"
        },
        {
          "value": "4/3",
          "label": "Landscape 4:3"
        },
        {
          "value": "16/9",
          "label": "Wide 16:9"
        }
      ],
      "default": "4/5"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between image and text",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "text",
          "label": "Text link"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "text"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "header",
      "content": "Field colors"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote color",
      "info": "Leave blank to use the default."
    }
  ],
  "presets": [
    {
      "name": "Philosophy"
    }
  ]
}{% endschema %}
