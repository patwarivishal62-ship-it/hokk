{%- comment -%}
  House of Kala Katha — Region hero
  Editorial introduction for a regional culture page (North India, etc.).
  Settings-only section: eyebrow, H1, supporting line, intro copy.
{%- endcomment -%}

<div class="cr-hero"
  style="--section-pad-top: {{ section.settings.padding_top }}px; --section-pad-bottom: {{ section.settings.padding_bottom }}px;{% if section.settings.background_color != blank %}background: {{ section.settings.background_color }};{% endif %}{% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}">
  <div class="container" data-reveal>
    {%- if section.settings.show_breadcrumb -%}
      <nav class="breadcrumbs cr-hero__breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
        <span aria-hidden="true">/</span>
        {%- if pages['culture'].url != blank -%}
          <a href="{{ pages['culture'].url }}">{{ pages['culture'].title | default: 'Culture' }}</a>
          <span aria-hidden="true">/</span>
        {%- endif -%}
        <span aria-current="page">{{ page.title | default: section.settings.heading }}</span>
      </nav>
    {%- endif -%}

    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="cr-hero__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.supporting != blank -%}
      <p class="cr-hero__sub">{{ section.settings.supporting | escape }}</p>
    {%- endif -%}

    {%- if section.settings.intro != blank -%}
      <div class="rte cr-hero__intro">{{ section.settings.intro }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Region hero",
  "class": "section-cr-hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Editorial introduction for a regional culture page. Pair with one or two “Region archive” sections below it."
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Culture of India"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (H1)",
      "info": "The page's main heading. One H1 per page — leave blank if the heading lives inside a banner image.",
      "default": "North India's Textile & Handcraft Cultures"
    },
    {
      "type": "text",
      "id": "supporting",
      "label": "Supporting line",
      "default": "Wool from high pastures, silk on a holy river, needlework in courtyards and cities."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F7F3EE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    { "name": "Region hero" }
  ]
}
{% endschema %}
