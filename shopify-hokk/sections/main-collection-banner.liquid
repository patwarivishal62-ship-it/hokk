<div class="collection-banner collection-banner--{{ section.settings.layout }} collection-banner--align-{{ section.settings.text_alignment }}"
  style="
    --section-pad-top: {{ section.settings.padding_top }}px;
    --section-pad-bottom: {{ section.settings.padding_bottom }}px;
    --cb-img-ratio: {{ section.settings.image_ratio }};
    --cb-img-radius: {{ section.settings.image_radius }}px;
    --cb-gap: {{ section.settings.gap }}px;
    {% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}
    {% if section.settings.background_color != blank and section.settings.background_image == blank and section.settings.background_video == blank %}background: {{ section.settings.background_color }};{% endif %}
    --font-heading-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
  ">
  {% style %}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {% endstyle %}
  {%- if section.settings.background_video != blank or section.settings.background_image != blank -%}
    {%- render 'section-background', bg_video: section.settings.background_video, bg_image: section.settings.background_image, bg_overlay: section.settings.background_color, bg_overlay_opacity: section.settings.overlay_opacity -%}
  {%- endif -%}
  <div class="container">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
        <span aria-hidden="true">/</span>
        <a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a>
        {%- if collection.title != blank -%}
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ collection.title }}</span>
        {%- endif -%}
      </nav>
    {%- endif -%}

    <div class="collection-banner__grid">
      <div class="collection-banner__body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="collection-banner__title">{{ collection.title | default: shop.name }}</h1>
        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="rte collection-banner__description">{{ collection.description }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.layout != 'text-only' and collection.featured_image != blank -%}
        <div class="collection-banner__media">
          {{ collection.featured_image | image_url: width: 1400 | image_tag:
            loading: 'eager',
            widths: '540, 720, 900, 1080, 1296',
            class: 'collection-banner__img',
            alt: collection.title | escape
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}{
  "name": "Collection banner",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Wardrobe"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "image-right",
          "label": "Image right"
        },
        {
          "value": "image-left",
          "label": "Image left"
        },
        {
          "value": "text-only",
          "label": "Text only"
        }
      ],
      "default": "image-right"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "4/3",
          "label": "Landscape 4:3"
        },
        {
          "value": "16/9",
          "label": "Wide 16:9"
        },
        {
          "value": "1/1",
          "label": "Square 1:1"
        },
        {
          "value": "4/5",
          "label": "Portrait 4:5"
        }
      ],
      "default": "4/3"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between text and image",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Solid background on its own — or a tint over the background image/video."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video",
      "info": "Plays on loop, muted. Takes priority over the image."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "Fades the background color over the image/video so text stays readable."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "fraunces_n6"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave blank to use the default."
    }
  ],
  "presets": [
    {
      "name": "Collection banner"
    }
  ]
}{% endschema %}
