<div class="collection-banner">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      {%- if collection.title != blank -%}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ collection.title }}</span>
      {%- endif -%}
    </nav>

    <div class="collection-banner__grid">
      <div class="collection-banner__body">
        <p class="eyebrow">The Wardrobe</p>
        <h1 class="collection-banner__title">{{ collection.title | default: 'Shop' }}</h1>
        {%- if collection.description != blank -%}
          <div class="rte collection-banner__description">{{ collection.description }}</div>
        {%- endif -%}
      </div>
      {%- if collection.featured_image != blank -%}
        <div class="collection-banner__media">
          {{ collection.featured_image | image_url: width: 1200 | image_tag:
            loading: 'eager',
            widths: '540, 720, 900, 1080',
            class: 'collection-banner__img',
            alt: collection.title | escape
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection banner",
  "class": "section-collection-banner",
  "settings": []
}
{% endschema %}
