{%- liquid
  assign items = section.settings.items | split: '|'
-%}

{%- if items.size > 0 -%}
  <div class="marquee" data-marquee style="--marquee-duration: {{ section.settings.speed }}s; --marquee-pad-top: {{ section.settings.padding_top }}px; {% if section.settings.background_color != blank %}--sec-bg: {{ section.settings.background_color }};{% endif %}{% if section.settings.text_color != blank %}--sec-text: {{ section.settings.text_color }};{% endif %}--marquee-pad-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="marquee__track">
      <div class="marquee__group">
        {%- for item in items -%}
          <span class="marquee__item">{{ item | strip }}</span>
          <span class="marquee__dot" aria-hidden="true">✦</span>
        {%- endfor -%}
      </div>
      <div class="marquee__group" aria-hidden="true">
        {%- for item in items -%}
          <span class="marquee__item">{{ item | strip }}</span>
          <span class="marquee__dot">✦</span>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}{
  "name": "Marquee",
  "class": "section-marquee",
  "settings": [
    {
      "type": "textarea",
      "id": "items",
      "label": "Items",
      "info": "Separate each item with a vertical bar |",
      "default": "HANDLOOM | IKAT | KALAMKARI | PATOLA | HERITAGE REIMAGINED | KALA · ART | KATHA · STORY | WOVEN IN INDIA"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Speed",
      "min": 15,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave blank to use the default."
    }
  ],
  "presets": [
    {
      "name": "Marquee"
    }
  ]
}{% endschema %}
