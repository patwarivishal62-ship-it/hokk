{%- liquid
  assign products_per_page = section.settings.products_per_page
  assign columns = section.settings.columns
  assign sort_by = collection.sort_by | default: collection.default_sort_by

  assign has_active_filters = false
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign has_active_filters = true
      endif
    else
      for value in filter.values
        if value.active
          assign has_active_filters = true
        endif
      endfor
    endif
  endfor
-%}

<div class="collection-grid collection-grid--align-{{ section.settings.card_alignment }}" data-section-id="{{ section.id }}"
  style="
    --section-pad-top: {{ section.settings.padding_top }}px;
    --section-pad-bottom: {{ section.settings.padding_bottom }}px;
    --card-ratio: {{ section.settings.image_ratio }};
    --cg-img-radius: {{ section.settings.image_radius }}px;
    --cg-gap: {{ section.settings.gap }}px;
    {% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}
    {% if section.settings.background_color != blank and section.settings.background_image == blank and section.settings.background_video == blank %}background: {{ section.settings.background_color }};{% endif %}
    --font-heading-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
  ">
  {% style %}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {% endstyle %}
  {%- if section.settings.background_video != blank or section.settings.background_image != blank -%}
    {%- render 'section-background', bg_video: section.settings.background_video, bg_image: section.settings.background_image, bg_overlay: section.settings.background_color, bg_overlay_opacity: section.settings.overlay_opacity -%}
  {%- endif -%}
  <div class="container">
    {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
    <form class="facets" method="get" action="{{ collection.url }}" data-filter-form>
      <div class="facets__toolbar">
        <p class="facets__count">
          {{ collection.products_count }}
          {%- if collection.products_count == 1 -%} product{%- else -%} products{%- endif -%}
        </p>

        <div class="facets__controls">
          {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
            <button type="button" class="btn btn--outline facets__toggle" data-filters-toggle>
              {{ 'sections.collection.filter' | t }}
            </button>
          {%- endif -%}

          {%- if section.settings.enable_sorting -%}
            <input type="hidden" name="sort_by" value="{{ sort_by }}" data-sort-hidden>
            <details class="sort-menu" data-sort-menu>
              <summary class="btn btn--outline sort-menu__toggle">
                {{ 'sections.collection.sort' | t }}
                {%- render 'icon', icon: 'chevron-down' -%}
              </summary>
              <div class="sort-menu__dropdown">
                <button type="button" class="sort-menu__option{% if sort_by == 'manual' %} is-current{% endif %}" data-sort-value="manual">Featured</button>
                <button type="button" class="sort-menu__option{% if sort_by == 'best-selling' %} is-current{% endif %}" data-sort-value="best-selling">Best selling</button>
                <button type="button" class="sort-menu__option{% if sort_by == 'title-ascending' %} is-current{% endif %}" data-sort-value="title-ascending">Alphabetically, A–Z</button>
                <button type="button" class="sort-menu__option{% if sort_by == 'title-descending' %} is-current{% endif %}" data-sort-value="title-descending">Alphabetically, Z–A</button>
                <button type="button" class="sort-menu__option{% if sort_by == 'price-ascending' %} is-current{% endif %}" data-sort-value="price-ascending">Price, low to high</button>
                <button type="button" class="sort-menu__option{% if sort_by == 'price-descending' %} is-current{% endif %}" data-sort-value="price-descending">Price, high to low</button>
                <button type="button" class="sort-menu__option{% if sort_by == 'created-descending' %} is-current{% endif %}" data-sort-value="created-descending">Date, new to old</button>
                <button type="button" class="sort-menu__option{% if sort_by == 'created-ascending' %} is-current{% endif %}" data-sort-value="created-ascending">Date, old to new</button>
              </div>
            </details>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
        <div class="facets__panel" data-filters-panel hidden>
          {%- for filter in collection.filters -%}
            <details class="facet">
              <summary class="facet__summary">
                {{ filter.label }}
                {%- render 'icon', icon: 'chevron-down' -%}
              </summary>
              <div class="facet__body">
                {%- case filter.type -%}
                  {%- when 'boolean' or 'list' -%}
                    {%- for value in filter.values -%}
                      <label class="facet__value">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          data-auto-submit
                        >
                        <span>{{ value.label }}</span>
                        <small class="facet__count">{% if value.count > 0 %}{{ value.count }}{% endif %}</small>
                      </label>
                    {%- endfor -%}
                  {%- when 'price_range' -%}
                    <div class="facet__price">
                      <label>
                        <span>From</span>
                        <input
                          name="{{ filter.min_value.param_name }}"
                          value="{{ filter.min_value.value }}"
                          type="number"
                          min="0"
                          inputmode="decimal"
                          placeholder="0"
                          {% if filter.min_value.value == nil %}disabled{% endif %}
                        >
                      </label>
                      <label>
                        <span>To</span>
                        <input
                          name="{{ filter.max_value.param_name }}"
                          value="{{ filter.max_value.value }}"
                          type="number"
                          min="0"
                          inputmode="decimal"
                          placeholder="∞"
                          {% if filter.max_value.value == nil %}disabled{% endif %}
                        >
                      </label>
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}

          <div class="facets__actions">
            <button type="submit" class="btn btn--solid">{{ 'sections.collection.apply' | t }}</button>
            {%- if has_active_filters -%}
              <a href="{{ collection.url }}" class="btn btn--text">{{ 'sections.collection.clear_all' | t }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </form>
    {%- endif -%}

    {%- paginate collection.products by products_per_page -%}
      <div class="product-grid product-grid--{{ columns }}">
        {%- for product in collection.products -%}
          {%- render 'card-product', product: product, show_vendor: section.settings.show_vendor, show_price: section.settings.show_price, show_secondary_image: section.settings.show_secondary_image -%}
        {%- else -%}
          <div class="collection-grid__empty">
            <p>{{ 'sections.collection.empty' | t }}</p>
          </div>
        {%- endfor -%}
      </div>

      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}{
  "name": "Product grid",
  "class": "section-collection-product-grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "3/4",
          "label": "Portrait 3:4"
        },
        {
          "value": "4/5",
          "label": "Portrait 4:5"
        },
        {
          "value": "1/1",
          "label": "Square 1:1"
        },
        {
          "value": "4/3",
          "label": "Landscape 4:3"
        }
      ],
      "default": "3/4"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Toolbar"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Solid background on its own — or a tint over the background image/video."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video",
      "info": "Plays on loop, muted. Takes priority over the image."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "Fades the background color over the image/video so text stays readable."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "fraunces_n6"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave blank to use the default."
    }
  ],
  "presets": [
    {
      "name": "Product grid"
    }
  ]
}{% endschema %}
