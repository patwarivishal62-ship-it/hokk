{%- liquid
  assign bg = section.settings.background
  if bg == blank
    assign bg_url = 'cta-texture.jpg' | asset_url
  else
    assign bg_url = bg | image_url: width: 2400
  endif
-%}

<div class="newsletter newsletter--image" data-reveal style="--newsletter-bg: url('{{ bg_url }}');">
  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="newsletter__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <div class="container">
    <div class="newsletter__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="newsletter__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="newsletter-form__success" tabindex="-1">
            {%- render 'icon', icon: 'check' -%}
            {{ 'newsletter.success' | t }}
          </p>
        {%- else -%}
          <div class="newsletter-form__field">
            <input
              type="email"
              name="contact[email]"
              class="newsletter-form__input"
              value="{{ form.email }}"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              aria-label="{{ 'newsletter.label' | t }}"
              required
              {% if form.errors %}aria-invalid="true"{% endif %}
            >
            <button type="submit" class="btn btn--solid newsletter-form__submit">
              {{ section.settings.button_label | default: 'newsletter.submit' | t }}
            </button>
          </div>
          {%- if form.errors -%}
            <p class="newsletter-form__error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          <p class="newsletter-form__note">{{ 'newsletter.note' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "image_picker",
      "id": "background",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Be Part of the Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Katha"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "New drops, craft stories from the loom, and first access to limited-run pieces."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join the Katha"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
