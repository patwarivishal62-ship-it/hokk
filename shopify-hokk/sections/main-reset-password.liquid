<div class="account-auth">
  <div class="container">
    <div class="account-auth__inner">
      <h1 class="section-title">{{ 'customer.reset_password.title' | t }}</h1>

      {%- form 'reset_customer_password', class: 'auth-form' -%}
        {%- if form.errors -%}
          <p class="auth-form__error" role="alert">
            {%- render 'icon', icon: 'error' -%}
            {{ form.errors | default_errors }}
          </p>
        {%- endif -%}

        <label>
          <span>New password</span>
          <input type="password" name="customer[password]" required>
        </label>
        <label>
          <span>Confirm password</span>
          <input type="password" name="customer[password_confirmation]" required>
        </label>
        <button type="submit" class="btn btn--solid btn--full">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "class": "section-reset-password",
  "settings": []
}
{% endschema %}
