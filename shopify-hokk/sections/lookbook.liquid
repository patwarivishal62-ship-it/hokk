<div class="lookbook" data-reveal style="--section-pad-top: {{ section.settings.padding_top }}px; --section-pad-bottom: {{ section.settings.padding_bottom }}px; --lb-img-ratio: {{ section.settings.image_ratio }}; --lb-img-radius: {{ section.settings.image_radius }}px; --lb-gap: {{ section.settings.gap }}px;">
  <div class="container">
    <div class="lookbook__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="lookbook__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- assign lookbook_fallbacks = 'lookbook-1.jpg|category-jackets.jpg|lookbook-2.jpg' | split: '|' -%}
    <div class="lookbook__grid">
      {%- for block in section.blocks -%}
        <figure class="lookbook__item lookbook__item--{{ forloop.index }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag:
              loading: 'lazy',
              widths: '540, 720, 900, 1080',
              class: 'lookbook__img',
              alt: block.settings.image.alt | escape
            }}
          {%- else -%}
            {%- assign lb_idx = forloop.index0 | modulo: lookbook_fallbacks.size -%}
            <img src="{{ lookbook_fallbacks[lb_idx] | asset_url }}" alt="House of Kala Katha lookbook" class="lookbook__img" loading="lazy" width="1000" height="1250">
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption class="lookbook__caption">{{ block.settings.caption | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}{
  "name": "Lookbook",
  "class": "section-lookbook",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Field Notes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Light. Real Streets. Real People."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shot in natural light, worn by the culture."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "4/5",
          "label": "Portrait 4:5"
        },
        {
          "value": "3/4",
          "label": "Portrait 3:4"
        },
        {
          "value": "1/1",
          "label": "Square 1:1"
        },
        {
          "value": "4/3",
          "label": "Landscape 4:3"
        },
        {
          "value": "16/9",
          "label": "Wide 16:9"
        }
      ],
      "default": "4/5"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between images",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Golden hour, Hyderabad."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "caption": "Golden hour, Hyderabad."
          }
        },
        {
          "type": "image"
        },
        {
          "type": "image",
          "settings": {
            "caption": "Occasion, reimagined."
          }
        }
      ]
    }
  ]
}{% endschema %}
