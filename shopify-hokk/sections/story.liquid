{%- liquid
  assign bg = section.settings.background
  if bg == blank
    assign bg_url = 'cta-texture.jpg' | asset_url
  else
    assign bg_url = bg | image_url: width: 2400
  endif
-%}

<div class="story story--image" data-reveal style="--story-bg: url('{{ bg_url }}');">
  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="story__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <div class="container">
    <div class="story__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="story__intro">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="story__grid">
        {%- for block in section.blocks -%}
          <div class="story__cell" {{ block.shopify_attributes }}>
            <span class="story__label">{{ block.settings.label | escape }}</span>
            {%- if block.settings.title != blank -%}
              <h3 class="story__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="story__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn--{{ section.settings.button_style }}">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Story",
  "class": "section-story",
  "settings": [
    {
      "type": "image_picker",
      "id": "background",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Story in the Cloth"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This Season's Katha: The Ikat of Pochampally"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Intro text",
      "default": "Kala is the craft. Katha is everything around it — where it comes from, who makes it, why the pattern looks the way it does, and how it found its way onto a jacket you'd actually wear on a Tuesday."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See it worn"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "outline"
    }
  ],
  "blocks": [
    {
      "type": "cell",
      "name": "Story cell",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Region"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pochampally, Telangana"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "A village whose name is now synonymous with the double-ikat weave."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Story",
      "blocks": [
        { "type": "cell", "settings": { "label": "Region", "title": "Pochampally, Telangana", "text": "A village whose name is now synonymous with the double-ikat weave." } },
        { "type": "cell", "settings": { "label": "Technique", "title": "Ikat — Resist-Dyed Yarn", "text": "Threads are tie-dyed before weaving, so the pattern lives inside the yarn itself." } },
        { "type": "cell", "settings": { "label": "Motif", "title": "The Diamond Chowka", "text": "A geometric motif once reserved for temple textiles, now a print for the everyday." } },
        { "type": "cell", "settings": { "label": "Reimagined as", "title": "Shirts, Co-ords & Jackets", "text": "Cut into relaxed silhouettes that move with your day, not against it." } }
      ]
    }
  ]
}
{% endschema %}
