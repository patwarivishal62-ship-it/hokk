{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign columns = section.settings.columns
-%}

<div class="featured-collection featured-collection--align-{{ section.settings.card_alignment }}" data-reveal style="--section-pad-top: {{ section.settings.padding_top }}px; --section-pad-bottom: {{ section.settings.padding_bottom }}px; --card-ratio: {{ section.settings.image_ratio }}; --fc-img-radius: {{ section.settings.image_radius }}px; {% if section.settings.background_color != blank %}--sec-bg: {{ section.settings.background_color }};{% endif %}{% if section.settings.text_color != blank %}--sec-text: {{ section.settings.text_color }};{% endif %}--fc-gap: {{ section.settings.gap }}px;{% if section.settings.card_title_color != blank %}--fc-title: {{ section.settings.card_title_color }};{% endif %}{% if section.settings.price_color != blank %}--fc-price: {{ section.settings.price_color }};{% endif %}">
  <div class="container">
    <div class="featured-collection__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow"{% if section.settings.eyebrow_color != blank %} style="color: {{ section.settings.eyebrow_color }};"{% endif %}>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-title"{% if section.settings.heading_color != blank %} style="color: {{ section.settings.heading_color }};"{% endif %}>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="featured-collection__subheading"{% if section.settings.subheading_color != blank %} style="color: {{ section.settings.subheading_color }};"{% endif %}>{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="btn btn--text">
          {%- if section.settings.view_all_label != blank -%}{{ section.settings.view_all_label | escape }}{%- else -%}{{ 'general.view_all' | t }}{%- endif -%}
          {%- render 'icon', icon: 'arrow-right' -%}
        </a>
      {%- endif -%}
    </div>

    <div class="product-grid product-grid--{{ columns }}">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: products_to_show -%}
          {%- render 'card-product', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          <div class="card-product card-product--placeholder">
            <div class="card-product__media">
              {{ 'product-' | append: i | placeholder_svg_tag: 'card-product__img card-product__img--placeholder' }}
            </div>
            <div class="card-product__info">
              <h3 class="card-product__title">{{ 'homepage.onboarding.title' | t }}</h3>
              <div class="price"><span class="price__current">₹2,499</span></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}{
  "name": "Featured collection",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New This Week"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh Off the Loom"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Limited runs. When they're gone, the loom moves on."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show “View all” button",
      "default": true
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "“View all” button text",
      "default": "View all"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image ratio",
      "options": [
        {
          "value": "3/4",
          "label": "Portrait 3:4"
        },
        {
          "value": "4/5",
          "label": "Portrait 4:5"
        },
        {
          "value": "1/1",
          "label": "Square 1:1"
        },
        {
          "value": "4/3",
          "label": "Landscape 4:3"
        }
      ],
      "default": "3/4"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Product image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "header",
      "content": "Field colors"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "info": "Leave blank to use the default."
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}{% endschema %}
