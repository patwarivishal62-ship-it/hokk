{%- liquid
  assign columns = section.settings.columns | default: 3
  assign layout = section.settings.layout | default: 'slider'
  assign per_view = section.settings.slides_per_view | default: 3
-%}

<div class="testimonials{% if section.settings.alignment == 'center' %} testimonials--align-center{% endif %}{% unless section.settings.show_stars %} testimonials--no-stars{% endunless %}" data-reveal
  style="
    --section-pad-top: {{ section.settings.padding_top }}px;
    --section-pad-bottom: {{ section.settings.padding_bottom }}px;
    --tt-bg: {{ section.settings.background }};
    --tt-cols: {{ columns }};
    --tt-per-view: {{ per_view }};
    --tt-gap: {{ section.settings.gap }}px;
    --tt-card-bg: {{ section.settings.card_background }};
    --tt-card-radius: {{ section.settings.card_radius }}px;
    --tt-card-pad: {{ section.settings.card_padding }}px;
    --tt-avatar-size: {{ section.settings.avatar_size }}px;
    --tt-avatar-radius: {% if section.settings.avatar_shape == 'circle' %}50%{% else %}{{ section.settings.avatar_radius }}px{% endif %};
    {% if section.settings.text_color != blank %}--sec-text: {{ section.settings.text_color }};{% endif %}
  ">
    {%- render 'section-background', bg_video: section.settings.background_video, bg_image: section.settings.background_image -%}

  <div class="container">
    <div class="testimonials__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow"{% if section.settings.eyebrow_color != blank %} style="color: {{ section.settings.eyebrow_color }};"{% endif %}>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title"{% if section.settings.heading_color != blank %} style="color: {{ section.settings.heading_color }};"{% endif %}>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="testimonials__grid{% if layout == 'slider' %} testimonials__grid--slider{% endif %}"
      {% if layout == 'slider' %}data-testimonial-slider data-autoplay="{{ section.settings.enable_autoplay }}" data-delay="{{ section.settings.autoplay_delay | times: 1000 }}"{% endif %}>
      {%- for block in section.blocks -%}
        {%- liquid
          assign initials = block.settings.handle | remove: '@' | slice: 0, 1 | upcase
          if initials == blank
            assign initials = 'K'
          endif
        -%}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          <div class="testimonial__avatar">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 200 | image_tag:
                loading: 'lazy',
                widths: '100, 200',
                class: 'testimonial__avatar-img',
                alt: block.settings.handle | escape
              }}
            {%- else -%}
              <span class="testimonial__avatar-initials">{{ initials }}</span>
            {%- endif -%}
          </div>

          {%- if section.settings.show_stars -%}
            <div class="testimonial__stars" aria-hidden="true"{% if section.settings.stars_color != blank %} style="color: {{ section.settings.stars_color }};"{% endif %}>
              {%- for i in (1..5) -%}{%- render 'icon', icon: 'star' -%}{%- endfor -%}
            </div>
          {%- endif -%}

          <blockquote class="testimonial__quote"{% if section.settings.quote_color != blank %} style="color: {{ section.settings.quote_color }};"{% endif %}>“{{ block.settings.quote | escape }}”</blockquote>
          <figcaption class="testimonial__author">
            <span class="testimonial__handle"{% if section.settings.handle_color != blank %} style="color: {{ section.settings.handle_color }};"{% endif %}>{{ block.settings.handle | escape }}</span>
            <span class="testimonial__role"{% if section.settings.role_color != blank %} style="color: {{ section.settings.role_color }};"{% endif %}>{{ block.settings.role | escape }}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>

    {%- if layout == 'slider' and section.settings.show_arrows -%}
      <div class="testimonials__nav">
        <button type="button" class="testimonials__arrow testimonials__arrow--prev" data-slider-prev aria-label="{{ 'pagination.previous' | t }}">
          {%- render 'icon', icon: 'arrow-left' -%}
        </button>
        <button type="button" class="testimonials__arrow testimonials__arrow--next" data-slider-next aria-label="{{ 'pagination.next' | t }}">
          {%- render 'icon', icon: 'arrow-right' -%}
        </button>
      </div>
    {%- endif -%}

    {%- if layout == 'slider' and section.settings.show_dots -%}
      <div class="testimonials__dots" data-slider-dots>
        {%- for block in section.blocks -%}
          <button type="button" class="testimonials__dot{% if forloop.first %} is-active{% endif %}" data-slider-dot="{{ forloop.index0 }}" aria-label="{{ 'sections.testimonials.go_to_review' | t: number: forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}{
  "name": "Testimonials",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Worn by the Culture"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not Celebrities. Just Real Wardrobes."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "info": "Slider keeps the section compact when you have many reviews.",
      "options": [
        {
          "value": "slider",
          "label": "Slider (carousel)"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "slider"
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "Slides per view",
      "info": "How many reviews are visible at once on desktop.",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrow buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Auto-rotate",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Auto-rotate speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (grid layout)",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#F3ECE1"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Avatars"
    },
    {
      "type": "select",
      "id": "avatar_shape",
      "label": "Avatar shape",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "circle"
    },
    {
      "type": "range",
      "id": "avatar_size",
      "label": "Avatar size",
      "min": 40,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "avatar_radius",
      "label": "Avatar corner radius (square shape)",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Section styling"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#EDE3D3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "header",
      "content": "Field colors"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "stars_color",
      "label": "Star color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "handle_color",
      "label": "Handle color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "color",
      "id": "role_color",
      "label": "Role color",
      "info": "Leave blank to use the default."
    },
    {
      "type": "header",
      "content": "Background media"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video",
      "info": "Plays on loop, muted. Takes priority over the image."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo / avatar"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I didn't buy this because it was 'handloom'. I bought it because it's the best shirt in my closet."
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle",
          "default": "@ananya.codes"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / location",
          "default": "Micro-creator, Hyderabad"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "I didn't buy this because it was 'handloom'. I bought it because it's the best shirt in my closet.",
            "handle": "@ananya.codes",
            "role": "Micro-creator, Hyderabad"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Wore the co-ord to a wedding and to work the next week. That's rare with anything 'ethnic'.",
            "handle": "@rohanwrites",
            "role": "Creator, Bengaluru"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Every piece comes with the story of who made it. That hits different once you know it.",
            "handle": "@meher.talks",
            "role": "Creator, Chennai"
          }
        }
      ]
    }
  ]
}{% endschema %}
