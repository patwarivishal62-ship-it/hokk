{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<section class="product" data-section-id="{{ section.id }}"
  style="
    {% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}
    {% if section.settings.background_color != blank and section.settings.background_image == blank and section.settings.background_video == blank %}background: {{ section.settings.background_color }};{% endif %}
    --font-heading-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
  ">
  {% style %}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {% endstyle %}
  {%- if section.settings.background_video != blank or section.settings.background_image != blank -%}
    {%- render 'section-background', bg_video: section.settings.background_video, bg_image: section.settings.background_image, bg_overlay: section.settings.background_color, bg_overlay_opacity: section.settings.overlay_opacity -%}
  {%- endif -%}

  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      {%- if product.collections.first != blank -%}
        <span aria-hidden="true">/</span>
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      {%- endif -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="product__grid">
      <div class="product__media" data-product-gallery>
        {%- if product.media.size > 0 -%}
          <div class="product__media-feature">
            {%- for media in product.media -%}
              <div class="product__media-item{% if forloop.first %} is-active{% endif %}" data-feature-item data-media-id="{{ media.id }}">
                {%- liquid
                  assign media_alt = media.alt | default: product.title | escape
                -%}
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {{ media | image_url: width: 1400 | image_tag:
                      loading: 'eager',
                      widths: '540, 720, 900, 1080, 1296',
                      class: 'product__media-img',
                      alt: media_alt
                    }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag }}
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if product.media.size > 1 -%}
            <div class="product__thumbs">
              {%- for media in product.media -%}
                {%- liquid
                  assign thumb_image = media.preview_image | default: media
                  assign thumb_alt = media.alt | default: product.title | escape
                -%}
                <button
                  type="button"
                  class="product__thumb{% if forloop.first %} is-active{% endif %}"
                  data-thumb
                  data-media-id="{{ media.id }}"
                  aria-label="Show image {{ forloop.index }} of {{ product.media.size }}"
                  {% if forloop.first %}aria-current="true"{% endif %}
                >
                  {{ thumb_image | image_url: width: 300 | image_tag:
                    loading: 'lazy',
                    widths: '150, 220, 300',
                    class: 'product__thumb-img',
                    alt: thumb_alt
                  }}
                  {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                    <span class="product__thumb-badge">Video</span>
                  {%- elsif media.media_type == 'model' -%}
                    <span class="product__thumb-badge">3D</span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'product__media-img product__media-img--placeholder' }}
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <p class="product__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product__title">{{ product.title | escape }}</h1>

        <div class="product__price" data-product-price>
          {%- render 'price', product: product, variant: current_variant, use_variant: true -%}
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="product__save">
              Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}
            </span>
          {%- endif -%}
        </div>

        {%- if section.settings.show_sku and current_variant.sku != blank -%}
          <p class="product__sku">{{ 'products.product.sku' | t }}: {{ current_variant.sku }}</p>
        {%- endif -%}

        {%- form 'product', product, id: 'product-form', class: 'product-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-id>

          {%- render 'variant-picker', product: product, section_id: section.id, form_id: 'product-form' -%}

          <div class="product-form__actions">
            {%- if section.settings.enable_quantity -%}
              {%- render 'quantity-input', name: 'quantity', value: 1 -%}
            {%- endif -%}

            <button
              type="submit"
              name="add"
              class="btn btn--solid product-form__add"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
          </div>

          {%- if section.settings.show_dynamic_checkout -%}
            <div class="product-form__buy">
              {{ form | payment_button }}
            </div>
          {%- endif -%}
        {%- endform -%}

        {%- if product.description != blank -%}
          <details class="product-accordion" open>
            <summary class="product-accordion__summary">
              {{ 'products.product.description' | t }}
              {%- render 'icon', icon: 'chevron-down' -%}
            </summary>
            <div class="rte product-accordion__body">{{ product.description }}</div>
          </details>
        {%- endif -%}

        {%- if section.settings.care_text != blank -%}
          <details class="product-accordion">
            <summary class="product-accordion__summary">
              {{ 'products.product.care' | t }}
              {%- render 'icon', icon: 'chevron-down' -%}
            </summary>
            <div class="rte product-accordion__body">{{ section.settings.care_text }}</div>
          </details>
        {%- endif -%}

        {%- if section.settings.shipping_text != blank -%}
          <details class="product-accordion">
            <summary class="product-accordion__summary">
              {{ 'products.product.shipping' | t }}
              {%- render 'icon', icon: 'chevron-down' -%}
            </summary>
            <div class="rte product-accordion__body">{{ section.settings.shipping_text }}</div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media -%}
      "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    {%- if product.vendor != blank -%}"brand": { "@type": "Brand", "name": {{ product.vendor | json }} },{%- endif -%}
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ current_variant.price | divided_by: 100.00 | json }},
      "availability": "{% if current_variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
    }
  }
  </script>
</section>

{% schema %}{
  "name": "Product",
  "class": "section-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_quantity",
      "label": "Enable quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    },
    {
      "type": "header",
      "content": "Accordion content"
    },
    {
      "type": "richtext",
      "id": "care_text",
      "label": "Care text",
      "default": "<p>Handloom fabrics are naturally textured. Hand wash cold with a gentle detergent, dry in shade, and iron warm on the reverse. Minor irregularities are the signature of the loom, not a flaw.</p>"
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping & returns text",
      "default": "<p>Dispatched within 2–3 business days from India. Free shipping on orders over ₹3,000. Easy 7-day returns on unworn pieces with tags intact.</p>"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Solid background on its own — or a tint over the background image/video."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video",
      "info": "Plays on loop, muted. Takes priority over the image."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "Fades the background color over the image/video so text stays readable."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "fraunces_n6"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave blank to use the default."
    }
  ]
}{% endschema %}
