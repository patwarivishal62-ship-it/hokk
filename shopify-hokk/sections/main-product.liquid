{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign layout = section.settings.layout | default: 'media-left'
  if section.settings.image_ratio == 'natural'
    assign image_ratio_css = 'auto'
  else
    assign image_ratio_css = section.settings.image_ratio
  endif
-%}

<section class="product product--{{ layout }}" data-section-id="{{ section.id }}"
  style="
    --section-pad-top: {{ section.settings.padding_top }}px;
    --section-pad-bottom: {{ section.settings.padding_bottom }}px;
    --p-img-ratio: {{ image_ratio_css }};
    --p-img-radius: {{ section.settings.image_radius }}px;
  ">
  <div class="container">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
        <span aria-hidden="true">/</span>
        <a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a>
        {%- if product.collections.first != blank -%}
          <span aria-hidden="true">/</span>
          <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        {%- endif -%}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ product.title }}</span>
      </nav>
    {%- endif -%}

    <div class="product__grid">
      <div class="product__media">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div class="product__media-item">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{ media | image_url: width: 1400 | image_tag:
                    loading: 'eager',
                    widths: '540, 720, 900, 1080, 1296',
                    class: 'product__media-img',
                    alt: media.alt | default: product.title | escape
                  }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true }}
                {%- when 'model' -%}
                  {{ media | model_viewer_tag }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'product__media-img product__media-img--placeholder' }}
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <p class="product__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product__title">{{ product.title | escape }}</h1>

        <div class="product__price" data-product-price>
          {%- render 'price', product: product, variant: current_variant, use_variant: true -%}
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="product__save">
              Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}
            </span>
          {%- endif -%}
        </div>

        {%- if section.settings.show_sku and current_variant.sku != blank -%}
          <p class="product__sku">{{ 'products.product.sku' | t }}: {{ current_variant.sku }}</p>
        {%- endif -%}

        {%- form 'product', product, id: 'product-form', class: 'product-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-id>

          {%- render 'variant-picker', product: product, section_id: section.id, form_id: 'product-form' -%}

          <div class="product-form__actions">
            {%- if section.settings.enable_quantity -%}
              {%- render 'quantity-input', name: 'quantity', value: 1 -%}
            {%- endif -%}

            <button
              type="submit"
              name="add"
              class="btn btn--solid product-form__add"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                {%- if section.settings.button_label != blank -%}{{ section.settings.button_label | escape }}{%- else -%}{{ 'products.product.add_to_cart' | t }}{%- endif -%}
              {%- else -%}
                {%- if section.settings.sold_out_label != blank -%}{{ section.settings.sold_out_label | escape }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
              {%- endif -%}
            </button>
          </div>

          {%- if section.settings.show_dynamic_checkout -%}
            <div class="product-form__buy">
              {{ form | payment_button }}
            </div>
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.show_description and product.description != blank -%}
          <details class="product-accordion" open>
            <summary class="product-accordion__summary">
              {{ 'products.product.description' | t }}
              {%- render 'icon', icon: 'chevron-down' -%}
            </summary>
            <div class="rte product-accordion__body">{{ product.description }}</div>
          </details>
        {%- endif -%}

        {%- if section.settings.care_text != blank -%}
          <details class="product-accordion">
            <summary class="product-accordion__summary">
              {{ 'products.product.care' | t }}
              {%- render 'icon', icon: 'chevron-down' -%}
            </summary>
            <div class="rte product-accordion__body">{{ section.settings.care_text }}</div>
          </details>
        {%- endif -%}

        {%- if section.settings.shipping_text != blank -%}
          <details class="product-accordion">
            <summary class="product-accordion__summary">
              {{ 'products.product.shipping' | t }}
              {%- render 'icon', icon: 'chevron-down' -%}
            </summary>
            <div class="rte product-accordion__body">{{ section.settings.shipping_text }}</div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media -%}
      "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    {%- if product.vendor != blank -%}"brand": { "@type": "Brand", "name": {{ product.vendor | json }} },{%- endif -%}
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ current_variant.price | divided_by: 100.00 | json }},
      "availability": "{% if current_variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
    }
  }
  </script>
</section>

{% schema %}
{
  "name": "Product",
  "class": "section-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_quantity",
      "label": "Enable quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "media-left",
          "label": "Media left"
        },
        {
          "value": "media-right",
          "label": "Media right"
        },
        {
          "value": "media-top",
          "label": "Media on top"
        }
      ],
      "default": "media-left"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "3/4",
          "label": "Portrait 3:4"
        },
        {
          "value": "4/5",
          "label": "Portrait 4:5"
        },
        {
          "value": "1/1",
          "label": "Square 1:1"
        },
        {
          "value": "4/3",
          "label": "Landscape 4:3"
        },
        {
          "value": "natural",
          "label": "Natural (no crop)"
        }
      ],
      "default": "3/4"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Buy button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to bag button text",
      "info": "Leave blank to use the default “Add to bag”.",
      "default": ""
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out button text",
      "info": "Leave blank to use the default “Sold out”.",
      "default": ""
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "Accordion content"
    },
    {
      "type": "richtext",
      "id": "care_text",
      "label": "Care text",
      "default": "<p>Handloom fabrics are naturally textured. Hand wash cold with a gentle detergent, dry in shade, and iron warm on the reverse. Minor irregularities are the signature of the loom, not a flaw.</p>"
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping & returns text",
      "default": "<p>Dispatched within 2–3 business days from India. Free shipping on orders over ₹3,000. Easy 7-day returns on unworn pieces with tags intact.</p>"
    }
  ],
  "presets": [
    {
      "name": "Product"
    }
  ]
}
{% endschema %}
