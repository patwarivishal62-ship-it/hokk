<div class="contact">
  <div class="container">
    <div class="contact__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- form 'contact', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="contact-form__success" tabindex="-1">
            {%- render 'icon', icon: 'check' -%}
            {{ 'contact.form.success' | t }}
          </p>
        {%- endif -%}

        <div class="contact-form__fields">
          <label>
            <span>{{ 'contact.form.name' | t }}</span>
            <input type="text" name="contact[name]" value="{{ form.name }}" required>
          </label>
          <label>
            <span>{{ 'contact.form.email' | t }}</span>
            <input type="email" name="contact[email]" value="{{ form.email }}" required>
          </label>
        </div>
        <label>
          <span>{{ 'contact.form.phone' | t }}</span>
          <input type="tel" name="contact[phone]" value="{{ form.phone }}">
        </label>
        <label>
          <span>{{ 'contact.form.message' | t }}</span>
          <textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea>
        </label>
        <button type="submit" class="btn btn--solid">{{ 'contact.form.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Talk to the house"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
