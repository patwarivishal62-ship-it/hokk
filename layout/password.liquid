<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_scheme_1_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="robots" content="noindex, nofollow">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- render 'theme-tokens' -%}
    {%- render 'meta-tags' -%}

    <title>{{ shop.name }} &ndash; {{ 'general.password_page.opening_soon' | t }}</title>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    {%- if settings.custom_head_code != blank -%}
      {{ settings.custom_head_code }}
    {%- endif -%}

    <script>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>
  </head>

  <body
    class="template-password"
    data-animations="{% if settings.animations_enable %}{{ settings.animations_style }}{% else %}none{% endif %}"
    data-stagger="{% if settings.animations_stagger %}true{% else %}false{% endif %}"
    data-arch="{% if settings.arch_enable %}{{ settings.arch_shape }}{% else %}off{% endif %}"
    data-btn-hover="{{ settings.button_hover }}"
  >
    {%- render 'clip-paths' -%}

    <main id="MainContent" class="main-content" role="main">
      {{ content_for_layout }}
    </main>

    {%- if settings.custom_body_code != blank -%}
      {{ settings.custom_body_code }}
    {%- endif -%}
  </body>
</html>
