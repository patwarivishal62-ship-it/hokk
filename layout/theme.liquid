<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_scheme_1_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_body_custom_url == blank and settings.type_header_custom_url == blank -%}
      {%- if settings.type_header_custom_url != blank -%}
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="{{ settings.type_header_custom_url }}">
      {%- endif -%}
      {%- if settings.type_body_custom_url != blank -%}
        <link rel="stylesheet" href="{{ settings.type_body_custom_url }}">
      {%- endif -%}
    {%- endunless -%}

    {%- render 'theme-tokens' -%}

    {%- render 'meta-tags' -%}

    <title>
      {%- if request.page_type == '404' -%}
        Page not found &ndash; {{ shop.name }}
      {%- else -%}
        {{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}
      {%- endif -%}
    </title>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}


    {{ content_for_header }}

    {%- if settings.custom_head_code != blank -%}
      {{ settings.custom_head_code }}
    {%- endif -%}

    <script>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>
  </head>

  <body
    class="template-{{ template.name | handleize }}{% if request.page_type == 'index' %} template-index{% endif %}"
    data-animations="{% if settings.animations_enable %}{{ settings.animations_style }}{% else %}none{% endif %}"
    data-stagger="{% if settings.animations_stagger %}true{% else %}false{% endif %}"
    data-header-behavior="{{ settings.header_behavior }}"
    data-cart-type="{{ settings.cart_type }}"
    data-currency-code="{% if settings.currency_code_enable %}true{% else %}false{% endif %}"
    data-image-quality="{{ settings.image_quality }}"
    data-arch="{% if settings.arch_enable %}{{ settings.arch_shape }}{% else %}off{% endif %}"
    data-arch-cards="{% if settings.arch_on_cards %}true{% else %}false{% endif %}"
    data-badge-shape="{{ settings.product_badge_shape }}"
    data-hover-zoom="{% if settings.image_hover_zoom %}true{% else %}false{% endif %}"
    data-btn-hover="{{ settings.button_hover }}"
    data-card-hover="{% if settings.card_shadow_on_hover %}true{% else %}false{% endif %}"
    data-align="{{ settings.product_text_align }}"
    data-print-border="{% if settings.print_border_enable %}{{ settings.print_border_style }}{% else %}off{% endif %}"
    data-full-bleed="{% if settings.full_bleed_mobile %}true{% else %}false{% endif %}"
  >
    {%- render 'clip-paths' -%}

    <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- render 'cart-drawer' -%}
    {%- render 'back-to-top' -%}
    {%- render 'whatsapp-button' -%}
    {%- render 'modal' -%}

    <script>
      window.KK = {
        moneyFormat: {{ shop.money_format | json }},
        moneyWithCurrencyFormat: {{ shop.money_with_currency_format | json }},
        locale: {{ request.locale.iso_code | json }},
        currency: {{ cart.currency.iso_code | json }},
        cartType: {{ settings.cart_type | json }},
        freeShippingThreshold: {{ settings.cart_free_shipping_threshold | default: 0 }},
        lightbox: {% if settings.product_lightbox %}true{% else %}false{% endif %},
        searchCollections: {% if settings.predictive_search_collections %}true{% else %}false{% endif %},
        searchPages: {% if settings.predictive_search_pages %}true{% else %}false{% endif %},
        predictiveLimit: {{ settings.predictive_search_limit | default: 5 }},
        routes: {
          cart: {{ routes.cart_url | json }},
          search: {{ routes.search_url | json }},
          root: {{ routes.root_url | json }},
          account: {{ routes.account_url | json }},
          collections: {{ routes.collections_url | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          inStock: {{ 'products.product.inventory.in_stock' | t | json }},
          lowStock: {{ 'products.product.inventory.low_stock' | t | json }},
          backorder: {{ 'products.product.inventory.backorder' | t | json }},
          cartError: "This item could not be added to your cart.",
          freeShippingMet: {{ 'cart.general.free_shipping_met' | t | json }},
          freeShippingRemaining: {{ 'cart.general.free_shipping_remaining' | t | json }},
          remove: {{ 'cart.general.remove' | t | json }},
          quantity: {{ 'cart.general.quantity' | t | json }},
          increase: "Increase quantity",
          decrease: "Decrease quantity",
          noResults: {{ 'general.search.no_results' | t: terms: '' | json }},
          viewAll: {{ 'general.search.view_all' | t | json }},
          products: {{ 'general.search.products' | t | json }},
          collections: {{ 'general.search.collections' | t | json }},
          pages: {{ 'general.search.pages' | t | json }},
          suggestions: {{ 'general.search.suggestions' | t | json }},
          copied: {{ 'general.share.copied' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {%- if settings.custom_body_code != blank -%}
      {{ settings.custom_body_code }}
    {%- endif -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>
  </body>
</html>
