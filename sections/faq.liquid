{%- comment -%}
  FAQ — question and answer accordions, optionally split into two columns.
{%- endcomment -%}
{%- liquid
  assign blocks = section.blocks
  assign half = blocks.size | divided_by: 2.0 | ceil
-%}
<div class="faq section color-scheme-{{ section.settings.color_scheme }} faq--{{ section.settings.layout }}" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="faq__head">
      {%- render 'section-header',
        eyebrow: section.settings.eyebrow,
        title: section.settings.heading,
        text: section.settings.text,
        align: section.settings.header_alignment,
        show_motif: section.settings.show_motif,
        animate: true
      -%}
    </div>

    {%- if section.settings.layout == 'split' -%}
      <div class="faq__columns">
        <div class="faq__column">
          {%- for block in blocks limit: half -%}
            {%- render 'faq-item', block: block, first: forloop.first -%}
          {%- endfor -%}
        </div>
        <div class="faq__column">
          {%- for block in blocks offset: half -%}
            {%- render 'faq-item', block: block, first: forloop.first -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="faq__list">
        {%- for block in blocks -%}
          {%- render 'faq-item', block: block, first: forloop.first, open_first: section.settings.open_first -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.help_text != blank or section.settings.help_label != blank -%}
      <div class="faq__help">
        {%- if section.settings.help_text != blank -%}<p class="faq__help-text">{{ section.settings.help_text | escape }}</p>{%- endif -%}
        {%- if section.settings.help_label != blank -%}
          <a class="btn btn--outline btn--small" href="{{ section.settings.help_link | default: routes.root_url }}">{{ section.settings.help_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.faq__list,
.faq__columns { max-width: 54rem; margin: 2.4rem auto 0; }
.faq--split .faq__columns { max-width: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.6rem, 4vw, 3.4rem); align-items: start; }

.faq__item { border-bottom: var(--border-width) solid var(--border); }
.faq__item:first-child { border-top: var(--border-width) solid var(--border); }
.faq__summary { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1.1rem 0; list-style: none; cursor: pointer; }
.faq__summary::-webkit-details-marker { display: none; }
.faq__question { font-family: var(--font-heading); font-size: calc(var(--h3) * 0.74); line-height: 1.3; margin: 0; }
.faq__icon { flex: none; color: var(--accent); transition: transform 0.3s var(--ease); margin-top: 0.15rem; }
.faq__item[open] .faq__icon { transform: rotate(135deg); }
.faq__body { max-height: 0; overflow: hidden; transition: max-height 0.4s var(--ease); }
.faq__answer { padding-bottom: 1.3rem; color: var(--text-muted); font-size: var(--body-size-small); }
.faq__answer p:last-child { margin-bottom: 0; }

.faq__help { display: flex; align-items: center; justify-content: center; gap: 1.2rem; flex-wrap: wrap; margin-top: 2.8rem; padding-top: 1.8rem; border-top: var(--border-width) solid var(--border); }
.faq__help-text { margin: 0; color: var(--text-muted); }

@media (max-width: 749px) {
  .faq--split .faq__columns { grid-template-columns: 1fr; gap: 0; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "faq-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 — Ivory" },
        { "value": "2", "label": "Scheme 2 — Ink" },
        { "value": "3", "label": "Scheme 3 — Terracotta" },
        { "value": "4", "label": "Scheme 4 — Indigo" },
        { "value": "5", "label": "Scheme 5 — Marigold" },
        { "value": "6", "label": "Scheme 6 — Leaf" }
      ],
      "default": "1"
    },
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions we are asked often" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "split", "label": "Split" }
      ],
      "default": "center"
    },
    { "type": "checkbox", "id": "show_motif", "label": "Show decorative motif", "default": true },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "single", "label": "Single column" },
        { "value": "split", "label": "Two columns" }
      ],
      "default": "single"
    },
    { "type": "checkbox", "id": "open_first", "label": "Open the first answer by default", "default": true },
    { "type": "header", "content": "Help" },
    { "type": "text", "id": "help_text", "label": "Text", "default": "Still unsure about something?" },
    { "type": "text", "id": "help_label", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "help_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How should I wash block-printed cotton?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Cold water, a mild liquid detergent, and a short gentle cycle or hand wash. Dry in the shade — direct sun fades natural dyes faster than anything else. Iron on the reverse while slightly damp.</p>"
        },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "How should I wash block-printed cotton?", "open_by_default": true } },
        { "type": "faq_item", "settings": { "question": "Will the colours run?", "answer": "<p>Natural dyes settle after the first two washes. Wash separately in cold water until then.</p>" } },
        { "type": "faq_item", "settings": { "question": "How long does shipping take?", "answer": "<p>Orders leave Jaipur within 48 hours. Metro delivery is 2–4 days; international is 5–9 days with DHL.</p>" } },
        { "type": "faq_item", "settings": { "question": "Do you repair pieces?", "answer": "<p>Yes. Send anything back at any time and our makers will mend it — re-block a faded panel, re-solder a brass handle, re-stitch a hem.</p>" } },
        { "type": "faq_item", "settings": { "question": "Can I order in bulk for a hotel or restaurant?", "answer": "<p>We do. Write to us with your quantities and timelines and we will match you with a workshop.</p>" } }
      ]
    }
  ]
}
{% endschema %}
