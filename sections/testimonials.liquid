{%- comment -%}
  Testimonials — customer quotes as a grid or carousel.
{%- endcomment -%}
{%- liquid
  assign per_row = section.settings.columns_desktop
  assign cols_tablet = 2
  if per_row < 3
    assign cols_tablet = per_row
  endif
-%}
{%- style -%}
  /* Section spacing — Theme settings › this section */
  #shopify-section-{{ section.id }} {
    --section-pad-top: {{ section.settings.padding_top }}px;
    --section-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}
<div class="testimonials section color-scheme-{{ section.settings.color_scheme }} testimonials--{{ section.settings.card_style }}" data-section-id="{{ section.id }}">
  <div class="container">
    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      title: section.settings.heading,
      text: section.settings.text,
      align: section.settings.header_alignment,
      action_label: section.settings.action_label,
      action_link: section.settings.action_link,
      show_motif: section.settings.show_motif,
      animate: true
    -%}

    {%- if section.settings.layout == 'carousel' -%}
      <div class="slider testimonials__slider" data-slider data-per-view="{{ per_row }}" {% if section.settings.autoplay %}data-autoplay="true" data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}" data-loop="true"{% endif %}>
        <div class="slider__viewport grid testimonials__grid" style="--cols: {{ per_row }}; --cols-tablet: {{ cols_tablet }}; --cols-mobile: 1; --gutter: {{ section.settings.spacing }}px;">
          {%- for block in section.blocks -%}
            <div class="grid__item slider__slide" data-slide style="flex-basis: calc((100% - (var(--gutter) * (var(--cols) - 1))) / var(--cols));">
              {%- render 'testimonial-card', block: block, opts: section.settings -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if section.blocks.size > per_row or section.settings.autoplay -%}
          <div class="slider__controls">
            {%- if section.settings.show_arrows -%}
              <button type="button" class="slider__btn" data-slider-prev aria-label="{{ 'general.accessibility.previous' | t }}">{%- render 'icon', name: 'chevron-left', size: 18 -%}</button>
            {%- endif -%}
            <div class="slider__dots" data-slider-dots></div>
            {%- if section.settings.show_arrows -%}
              <button type="button" class="slider__btn" data-slider-next aria-label="{{ 'general.accessibility.next' | t }}">{%- render 'icon', name: 'chevron-right', size: 18 -%}</button>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="grid testimonials__grid" style="--cols: {{ per_row }}; --cols-tablet: {{ cols_tablet }}; --cols-mobile: {{ section.settings.columns_mobile }}; --gutter: {{ section.settings.spacing }}px;">
        {%- for block in section.blocks -%}
          <div class="grid__item" data-load-item data-animate>
            {%- render 'testimonial-card', block: block, opts: section.settings -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.footer_note != blank -%}
      <p class="testimonials__note text-small">{{ section.settings.footer_note | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.testimonials__grid { margin-top: 2.6rem; }
.testimonials__slider .testimonials__grid { margin-top: 0; display: flex; }
.testimonials__slider .slider__controls { margin-top: 1.8rem; }
.testimonials__note { text-align: center; color: var(--text-muted); margin-top: 2rem; }

.testimonial-card {
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  position: relative;
}
.testimonials--card .testimonial-card {
  padding: clamp(1.4rem, 3vw, 2.2rem);
  background: var(--bg-card);
  border: var(--border-width) solid var(--border);
  border-radius: var(--card-radius);
  transition: var(--transition);
}
.testimonials--card .testimonial-card:hover { transform: translateY(-4px); box-shadow: var(--card-shadow-hover); border-color: rgba(var(--color-gold-rgb), 0.5); }
.testimonials--arch .testimonial-card {
  padding: clamp(1.6rem, 4vw, 2.6rem);
  background: var(--bg-card);
  border: var(--border-width) solid var(--border);
  border-radius: var(--image-radius) var(--image-radius) 50% 50% / var(--image-radius) var(--image-radius) 14% 14%;
  text-align: center;
  align-items: center;
}
.testimonials--bordered .testimonial-card { border-top: 2px solid rgba(var(--color-gold-rgb), 0.55); padding-top: 1.6rem; }

.testimonial-card__quote { margin: 0; font-size: 1.02rem; line-height: 1.6; }
.testimonial-card__mark { color: var(--accent); opacity: 0.45; display: inline-flex; margin-bottom: 0.4rem; }
.testimonial-card__meta { display: flex; align-items: center; gap: 0.8rem; margin-top: auto; padding-top: 0.4rem; }
.testimonial-card__avatar { width: 46px; height: 46px; border-radius: 999px; overflow: hidden; flex: none; background: var(--bg-secondary); }
.testimonial-card__avatar img { width: 100%; height: 100%; object-fit: cover; }
.testimonial-card__who { display: flex; flex-direction: column; }
.testimonial-card__name { font-family: var(--font-heading); font-size: 1rem; }
.testimonial-card__name a { color: inherit; text-decoration: none; }
.testimonial-card__name a:hover { color: var(--accent); }
.testimonial-card__role { font-size: var(--body-size-small); color: var(--text-muted); }
.testimonial-card__verified { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.72rem; color: var(--text-muted); letter-spacing: 0.06em; text-transform: uppercase; font-family: var(--font-eyebrow); }
.testimonial-card__verified .icon { color: var(--color-leaf); }

@media (max-width: 749px) {
  .testimonials__slider .grid > .grid__item { flex-basis: calc((100% - var(--gutter)) / 1.2) !important; }
}
{% endstylesheet %}

