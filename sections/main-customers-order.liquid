<div class="section customer-section color-scheme-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="container">
    {%- render 'breadcrumb' -%}

    {%- liquid
      assign order_date = order.created_at | date: '%e %B %Y' | strip
      assign cancelled_date = order.cancelled_at | date: '%e %B %Y' | strip
    -%}
    <header class="page-header">
      <p class="eyebrow">{{ 'customer.order.title' | t: name: order.name }}</p>
      <h1 class="page-header__title">{{ 'customer.order.date_html' | t: date: order_date }}</h1>
      {%- if order.cancelled -%}
        <div class="form-message form-message--error">
          <p>{{ 'customer.order.cancelled_html' | t: date: cancelled_date }}</p>
          <p>{{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}</p>
        </div>
      {%- endif -%}
      <div class="customer-links">
        <a class="btn btn--outline btn--small" href="{{ routes.account_url }}">{{ 'customer.account.return' | t }}</a>
      </div>
    </header>

    <div class="customer-order-grid">
      <section class="customer-card">
        <h2 class="customer-card__title h3">{{ 'customer.order.order_details' | t }}</h2>

        <div class="customer-order-items">
          {%- for line_item in order.line_items -%}
            <div class="customer-order-item">
              {%- if line_item.image -%}
                <img src="{{ line_item.image | image_url: width: 140 }}" alt="{{ line_item.image.alt | escape }}" width="70" loading="lazy">
              {%- else -%}
                <span></span>
              {%- endif -%}

              <div>
                <p class="customer-order-item__title">
                  {%- if line_item.product.url != blank -%}
                    <a class="link-plain" href="{{ line_item.product.url }}">{{ line_item.title | escape }}</a>
                  {%- else -%}
                    {{ line_item.title | escape }}
                  {%- endif -%}
                </p>
                {%- unless line_item.product.has_only_default_variant -%}
                  <p class="text-small text-muted">{{ line_item.variant.title | escape }}</p>
                {%- endunless -%}
                {%- if line_item.selling_plan_allocation -%}
                  <p class="text-small text-muted">{{ line_item.selling_plan_allocation.selling_plan.name | escape }}</p>
                {%- endif -%}
                {%- if line_item.properties.size > 0 -%}
                  <ul class="cart-item__properties" role="list">
                    {%- for property in line_item.properties -%}
                      {%- assign first_char = property.first | slice: 0 -%}
                      {%- if first_char != '_' and property.last != blank -%}
                        <li>{{ property.first | escape }}: {{ property.last | escape }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
                {%- if line_item.fulfillment -%}
                  <p class="text-small text-muted">
                    {%- assign fulfilled_date = line_item.fulfillment.created_at | date: '%e %B %Y' | strip -%}
                    {{ 'customer.order.fulfilled_at_html' | t: date: fulfilled_date }}
                    {%- if line_item.fulfillment.tracking_url -%}
                      · <a class="link-plain" href="{{ line_item.fulfillment.tracking_url }}">{{ 'customer.order.track_shipment' | t }}</a>
                    {%- endif -%}
                  </p>
                {%- endif -%}
                {%- if line_item.original_price != line_item.final_price -%}
                  <p class="text-small"><s class="price__compare">{{ line_item.original_price | money }}</s> <span class="price__sale">{{ line_item.final_price | money }}</span></p>
                {%- endif -%}
              </div>

              <div class="text-right">
                <p class="text-small text-muted">{{ 'customer.order.quantity' | t }}: {{ line_item.quantity }}</p>
                <p><strong>{{ line_item.final_line_price | money }}</strong></p>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="customer-totals">
          <div class="customer-totals__row"><span>{{ 'customer.order.subtotal' | t }}</span><span>{{ order.line_items_subtotal_price | money }}</span></div>
          {%- for discount_application in order.cart_level_discount_applications -%}
            <div class="customer-totals__row"><span>{{ 'customer.order.discount' | t }} · {{ discount_application.title | escape }}</span><span>&minus;{{ discount_application.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
          {%- for shipping_method in order.shipping_methods -%}
            <div class="customer-totals__row"><span>{{ 'customer.order.shipping' | t }} · {{ shipping_method.title | escape }}</span><span>{{ shipping_method.price | money }}</span></div>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <div class="customer-totals__row"><span>{{ 'customer.order.tax' | t }} ({{ tax_line.title | escape }} {{ tax_line.rate | times: 100 }}%)</span><span>{{ tax_line.price | money }}</span></div>
          {%- endfor -%}
          <div class="customer-totals__row customer-totals__row--total"><span>{{ 'customer.order.total' | t }}</span><span>{{ order.total_price | money_with_currency }}</span></div>
        </div>
      </section>

      <aside class="customer-address-grid" style="grid-template-columns: 1fr;">
        <div class="customer-card">
          <h2 class="customer-card__title h4">{{ 'customer.order.billing_address' | t }}</h2>
          <p class="customer-status" style="margin-bottom:0.7rem;">{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>
          <address class="customer-address-block text-small text-muted">{{ order.billing_address | format_address }}</address>
        </div>
        <div class="customer-card">
          <h2 class="customer-card__title h4">{{ 'customer.order.shipping_address' | t }}</h2>
          <p class="customer-status" style="margin-bottom:0.7rem;">{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>
          <address class="customer-address-block text-small text-muted">{{ order.shipping_address | format_address }}</address>
        </div>
      </aside>
    </div>
  </div>
</div>

{% stylesheet %}
.customer-order-grid { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: 1.4rem; align-items: start; }
@media (max-width: 989px) { .customer-order-grid { grid-template-columns: 1fr; } }
.customer-order-item__title { margin: 0 0 0.2rem; font-weight: 600; }
{% endstylesheet %}

{% schema %}
{
  "name": "Order details",
  "tag": "section",
  "class": "customer-order-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 — Ivory" },
        { "value": "2", "label": "Scheme 2 — Ink" },
        { "value": "3", "label": "Scheme 3 — Terracotta" },
        { "value": "4", "label": "Scheme 4 — Indigo" },
        { "value": "5", "label": "Scheme 5 — Marigold" },
        { "value": "6", "label": "Scheme 6 — Leaf" }
      ],
      "default": "1"
    }
  ]
}
{% endschema %}
