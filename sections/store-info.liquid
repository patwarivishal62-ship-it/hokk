{%- comment -%}
  Store info — stockists, studios and showrooms with hours and directions.
{%- endcomment -%}
{%- liquid
  assign per_row = section.settings.columns_desktop
  assign cols_tablet = 2
  if per_row < 3
    assign cols_tablet = per_row
  endif
-%}
<div class="store-info section color-scheme-{{ section.settings.color_scheme }} store-info--{{ section.settings.card_style }}" data-section-id="{{ section.id }}">
  <div class="container">
    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      title: section.settings.heading,
      text: section.settings.text,
      align: section.settings.header_alignment,
      action_label: section.settings.action_label,
      action_link: section.settings.action_link,
      show_motif: section.settings.show_motif,
      animate: true
    -%}

    <div class="grid store-info__grid" style="--cols: {{ per_row }}; --cols-tablet: {{ cols_tablet }}; --cols-mobile: {{ section.settings.columns_mobile }}; --gutter: {{ section.settings.spacing }}px;">
      {%- for block in section.blocks -%}
        <div class="grid__item" data-load-item data-animate>
          <article class="store-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="store-card__media media{% if section.settings.arch %} arch{% endif %}" style="aspect-ratio: {{ section.settings.image_ratio }};">
                <img
                  src="{{ block.settings.image | image_url: width: 700 }}"
                  srcset="{{ block.settings.image | image_url: width: 350 }} 350w, {{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 1000 }} 1000w"
                  sizes="(max-width: 749px) 92vw, (max-width: 989px) 44vw, {{ 100 | divided_by: per_row }}vw"
                  alt="{{ block.settings.image.alt | default: block.settings.name | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
                {%- if block.settings.badge != blank -%}<span class="store-card__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
              </div>
            {%- endif -%}

            <div class="store-card__body">
              <h3 class="store-card__name">{{ block.settings.name | escape }}</h3>

              {%- if block.settings.address != blank -%}
                <p class="store-card__row">{%- render 'icon', name: 'pin', size: 16 -%}<span class="rte">{{ block.settings.address }}</span></p>
              {%- endif -%}

              {%- if block.settings.hours != blank -%}
                <p class="store-card__row">{%- render 'icon', name: 'clock', size: 16 -%}<span class="rte">{{ block.settings.hours }}</span></p>
              {%- endif -%}

              {%- if block.settings.phone != blank -%}
                <p class="store-card__row">{%- render 'icon', name: 'phone', size: 16 -%}<a class="link-plain" href="tel:{{ block.settings.phone | remove: ' ' | escape }}">{{ block.settings.phone | escape }}</a></p>
              {%- endif -%}

              {%- if block.settings.email != blank -%}
                <p class="store-card__row">{%- render 'icon', name: 'mail', size: 16 -%}<a class="link-plain" href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email | escape }}</a></p>
              {%- endif -%}

              <div class="store-card__actions">
                {%- if block.settings.map_link != blank -%}
                  <a class="link-arrow" href="{{ block.settings.map_link }}" target="_blank" rel="noopener">
                    {{ block.settings.map_label | default: 'Get directions' | escape }}
                    {%- render 'icon', name: 'external', size: 14 -%}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a class="btn btn--outline btn--small" href="{{ block.settings.button_link | default: routes.root_url }}">{{ block.settings.button_label | escape }}</a>
                {%- endif -%}
              </div>
            </div>
          </article>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="store-info__note text-small">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.store-info__grid { margin-top: 2.6rem; }
.store-card {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border: var(--border-width) solid var(--border);
  border-radius: var(--card-radius);
  overflow: hidden;
  transition: var(--transition);
}
.store-card:hover { transform: translateY(-4px); box-shadow: var(--card-shadow-hover); border-color: rgba(var(--color-gold-rgb), 0.5); }

.store-info--plain .store-card { background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.store-info--plain .store-card:hover { transform: none; }
.store-info--arch .store-card__media img { border-radius: 50% 50% 0 0 / 26% 26% 0 0; }

.store-card__media { position: relative; display: block; overflow: hidden; }
.store-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.8s var(--ease); }
.store-card:hover .store-card__media img { transform: scale(1.05); }

.store-card__badge {
  position: absolute;
  top: 0.8rem;
  left: 0.8rem;
  padding: 0.3rem 0.7rem;
  border-radius: 999px;
  background: rgba(var(--color-ivory-rgb), 0.94);
  color: var(--color-ink);
  font-family: var(--font-eyebrow);
  font-size: 0.6rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.store-card__body { display: flex; flex-direction: column; gap: 0.7rem; padding: clamp(1.2rem, 3vw, 1.8rem); flex: 1; }
.store-card__name { font-size: var(--h4); margin: 0; }
.store-card__row { display: flex; gap: 0.6rem; align-items: flex-start; margin: 0; color: var(--text-muted); font-size: var(--body-size-small); }
.store-card__row .rte p { margin: 0; }
.store-card__row .icon { color: var(--accent); flex: none; margin-top: 0.1em; }
.store-card__row a { color: var(--text); text-decoration: none; }
.store-card__row a:hover { color: var(--accent); }

.store-card__actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: auto; padding-top: 0.8rem; border-top: var(--border-width) solid var(--border); }
.store-info--plain .store-card__actions { border-top: 0; padding-top: 0; }

.store-info__note { text-align: center; color: var(--text-muted); margin-top: 2rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Store info",
  "tag": "section",
  "class": "store-info-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 — Ivory" },
        { "value": "2", "label": "Scheme 2 — Ink" },
        { "value": "3", "label": "Scheme 3 — Terracotta" },
        { "value": "4", "label": "Scheme 4 — Indigo" },
        { "value": "5", "label": "Scheme 5 — Marigold" },
        { "value": "6", "label": "Scheme 6 — Leaf" }
      ],
      "default": "1"
    },
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Visit us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Come and touch the cloth" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Three rooms, three cities. Tea is always on.</p>" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "split", "label": "Split" }
      ],
      "default": "center"
    },
    { "type": "checkbox", "id": "show_motif", "label": "Show decorative motif", "default": true },
    { "type": "text", "id": "action_label", "label": "Header link label" },
    { "type": "url", "id": "action_link", "label": "Header link" },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "card", "label": "Boxed card" },
        { "value": "plain", "label": "No card" },
        { "value": "arch", "label": "Arched image" }
      ],
      "default": "card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "4 / 3", "label": "Landscape 4:3" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "16 / 9", "label": "Wide" }
      ],
      "default": "4 / 3"
    },
    { "type": "checkbox", "id": "arch", "label": "Arch mask on images", "default": false },
    {
      "type": "range",
      "id": "spacing",
      "label": "Space between cards",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    { "type": "text", "id": "note", "label": "Footer note", "default": "Private viewings by appointment — write to us and we will open the archive for you." }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Location",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Jaipur — the house" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Flagship" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "richtext", "id": "address", "label": "Address", "default": "<p>14 Chandpol Bazaar, Jaipur<br>Rajasthan 302001</p>" },
        { "type": "richtext", "id": "hours", "label": "Hours", "default": "<p>Mon – Sat, 10am – 7pm<br>Sunday by appointment</p>" },
        { "type": "text", "id": "phone", "label": "Phone", "default": "+91 98765 43210" },
        { "type": "text", "id": "email", "label": "Email", "default": "jaipur@houseofkalakatha.com" },
        { "type": "url", "id": "map_link", "label": "Map link" },
        { "type": "text", "id": "map_label", "label": "Map link label", "default": "Get directions" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Book a viewing" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store info",
      "blocks": [
        { "type": "store", "settings": { "name": "Jaipur — the house", "badge": "Flagship" } },
        { "type": "store", "settings": { "name": "Mumbai — Kala Room", "badge": "Studio", "address": "<p>2 Kala Ghoda Lane, Fort<br>Mumbai 400001</p>", "hours": "<p>Tue – Sun, 11am – 8pm</p>", "phone": "+91 98123 45678", "email": "mumbai@houseofkalakatha.com" } },
        { "type": "store", "settings": { "name": "Delhi — by appointment", "address": "<p>7 Lodhi Colony, New Delhi 110003</p>", "hours": "<p>Appointment only</p>", "phone": "+91 98000 11223", "email": "delhi@houseofkalakatha.com" } }
      ]
    }
  ]
}
{% endschema %}
