{%- comment -%}
  Multicolumn — icon or image columns for USPs, services, story beats.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout
  assign columns = section.settings.columns_desktop
  assign card = section.settings.card_style
  assign mobile = section.settings.columns_mobile
-%}
<div class="multicolumn section color-scheme-{{ section.settings.color_scheme }} multicolumn--{{ card }} multicolumn--align-{{ section.settings.text_alignment }}" data-section-id="{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      {%- render 'section-header',
        eyebrow: section.settings.eyebrow,
        title: section.settings.heading,
        text: section.settings.text,
        align: section.settings.header_alignment,
        action_label: section.settings.header_link_label,
        action_link: section.settings.header_link,
        show_motif: section.settings.show_motif
      -%}
    {%- endif -%}

    {%- if layout == 'carousel' -%}
      <div class="slider multicolumn__slider" data-slider data-per-view="{{ columns }}" data-loop="false">
        <div class="slider__viewport multicolumn__grid" style="--columns: {{ columns }}; --columns-tablet: 2; --columns-mobile: {{ mobile }}; --gutter: {{ section.settings.spacing }}px;">
          {%- for block in section.blocks -%}
            <div class="multicolumn__item slider__slide" data-slide style="flex-basis: calc((100% - (var(--gutter) * (var(--columns) - 1))) / var(--columns));" {{ block.shopify_attributes }}>
              {%- render 'multicolumn-item', block: block, card: card, opts: section.settings -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if section.blocks.size > columns -%}
          <div class="slider__controls">
            <button type="button" class="slider__btn" data-slider-prev aria-label="{{ 'general.accessibility.previous' | t }}">{%- render 'icon', name: 'chevron-left', size: 18 -%}</button>
            <div class="slider__dots" data-slider-dots></div>
            <button type="button" class="slider__btn" data-slider-next aria-label="{{ 'general.accessibility.next' | t }}">{%- render 'icon', name: 'chevron-right', size: 18 -%}</button>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="multicolumn__grid" style="--columns: {{ columns }}; --columns-tablet: 2; --columns-mobile: {{ mobile }}; --gutter: {{ section.settings.spacing }}px;">
        {%- for block in section.blocks -%}
          <div class="multicolumn__item" {{ block.shopify_attributes }}>
            {%- render 'multicolumn-item', block: block, card: card, opts: section.settings -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.multicolumn__grid {
  display: grid;
  grid-template-columns: repeat(var(--columns, 3), minmax(0, 1fr));
  gap: var(--gutter, 24px);
  margin-top: 2.6rem;
}
.multicolumn__slider .multicolumn__grid { display: flex; margin-top: 0; }
.multicolumn__slider .slider__viewport { padding-bottom: 0.4rem; }
.multicolumn__item { min-width: 0; }

.multicolumn__card {
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}
.multicolumn--box .multicolumn__card {
  padding: clamp(1.4rem, 3vw, 2.2rem);
  background: var(--bg-secondary, var(--bg-card));
  border: var(--border-width) solid var(--border);
  border-radius: var(--card-radius);
  transition: var(--transition);
}
.multicolumn--box .multicolumn__card:hover { transform: translateY(-4px); box-shadow: var(--card-shadow-hover); border-color: rgba(var(--color-gold-rgb), 0.5); }

.multicolumn__media { display: block; overflow: hidden; border-radius: var(--image-radius); }
.multicolumn__media img,
.multicolumn__media .placeholder-svg { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s var(--ease); }
.multicolumn__card:hover .multicolumn__media img { transform: scale(1.04); }
.multicolumn--arch .multicolumn__media { border-radius: 50% 50% var(--image-radius) var(--image-radius) / 32% 32% var(--image-radius) var(--image-radius); }
.multicolumn--circle .multicolumn__media { border-radius: 999px; }

.multicolumn__icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background: rgba(var(--color-terracotta-rgb), 0.12);
  color: var(--accent);
  border: var(--border-width) solid rgba(var(--color-gold-rgb), 0.35);
}
.multicolumn__icon .icon { width: 22px; height: 22px; }

.multicolumn__title { font-size: var(--h4); margin: 0; line-height: 1.25; }
.multicolumn__title a { text-decoration: none; color: inherit; }
.multicolumn__text { color: var(--text-muted); margin: 0; font-size: var(--body-size-small); }
.multicolumn__link { margin-top: auto; padding-top: 0.4rem; }
.multicolumn__link .link-plain { font-family: var(--font-eyebrow); font-size: var(--eyebrow-size); letter-spacing: 0.12em; text-transform: uppercase; }

.multicolumn--align-center .multicolumn__card { align-items: center; text-align: center; }
.multicolumn--align-right .multicolumn__card { align-items: flex-end; text-align: right; }

@media (max-width: 989px) {
  .multicolumn__grid { grid-template-columns: repeat(var(--columns-tablet, 2), minmax(0, 1fr)); }
}
@media (max-width: 749px) {
  .multicolumn__grid { grid-template-columns: repeat(var(--columns-mobile, 1), minmax(0, 1fr)); }
  .multicolumn__slider .multicolumn__grid > .multicolumn__item { flex-basis: calc((100% - var(--gutter)) / 1.4) !important; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "class": "multicolumn-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 — Ivory" },
        { "value": "2", "label": "Scheme 2 — Ink" },
        { "value": "3", "label": "Scheme 3 — Terracotta" },
        { "value": "4", "label": "Scheme 4 — Indigo" },
        { "value": "5", "label": "Scheme 5 — Marigold" },
        { "value": "6", "label": "Scheme 6 — Leaf" }
      ],
      "default": "1"
    },
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Kala Katha" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four reasons to keep it" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "header_link_label", "label": "Header link label" },
    { "type": "checkbox", "id": "show_motif", "label": "Show decorative motif", "default": true },
    { "type": "url", "id": "header_link", "label": "Header link" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "none", "label": "No card" },
        { "value": "box", "label": "Boxed card" },
        { "value": "arch", "label": "Arch image" },
        { "value": "circle", "label": "Round image" }
      ],
      "default": "box"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media",
      "options": [
        { "value": "icon", "label": "Icon" },
        { "value": "image", "label": "Image" }
      ],
      "default": "icon"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 4", "label": "Tall" },
        { "value": "16 / 9", "label": "Wide" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Space between columns",
      "min": 8,
      "max": 56,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "hand", "label": "Handmade" },
            { "value": "truck", "label": "Shipping" },
            { "value": "returns", "label": "Returns" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "chat", "label": "Chat" },
            { "value": "gift", "label": "Gift" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "star", "label": "Star" },
            { "value": "lotus", "label": "Lotus" },
            { "value": "elephant", "label": "Elephant" },
            { "value": "rupee", "label": "Rupee" }
          ],
          "default": "hand"
        },
        { "type": "image_picker", "id": "image", "label": "Image (used when media is set to image)" },
        { "type": "text", "id": "title", "label": "Heading", "default": "Handmade, not mass-made" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Each piece is finished by one maker, whose name is stamped underneath.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column", "settings": { "icon": "hand", "title": "Made by one pair of hands", "text": "<p>Every order names its maker. No assembly lines, no anonymous labour.</p>" } },
        { "type": "column", "settings": { "icon": "leaf", "title": "Natural dyes only", "text": "<p>Indigo, madder, pomegranate and iron — no azo dyes, ever.</p>" } },
        { "type": "column", "settings": { "icon": "truck", "title": "Ships in 48 hours", "text": "<p>Free across India above ₹5,000, and worldwide with DHL.</p>" } },
        { "type": "column", "settings": { "icon": "returns", "title": "14-day returns", "text": "<p>Changed your mind? Send it back unwashed and we will refund.</p>" } }
      ]
    }
  ]
}
{% endschema %}
