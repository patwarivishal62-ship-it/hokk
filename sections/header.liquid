{%- comment -%}
  Header — belongs to the header group.
  Handles logo placement, primary navigation with mega menus, predictive
  search, customer account link and the cart bubble/drawer trigger.
{%- endcomment -%}
{%- liquid
  assign menu = section.settings.menu
  if menu == blank
    assign menu = linklists.main-menu
  endif
  assign scheme = section.settings.color_scheme
  assign layout = section.settings.layout
-%}

<header
  class="header header--{{ layout }} color-scheme-{{ scheme }}{% if section.settings.show_border %} header--bordered{% endif %}{% if section.settings.compact_on_scroll %} header--compact{% endif %}"
  data-header
  data-section-id="{{ section.id }}"
  style="--header-padding: {{ section.settings.padding }}px;"
  role="banner"
>
  <div class="header__inner container">

    {%- comment -%} ---------------- LEFT ---------------- {%- endcomment -%}
    <div class="header__cell header__cell--left">
      {%- case layout -%}
        {%- when 'logo-left' -%}
          <button type="button" class="header__icon header__menu-btn hide-desktop" data-panel-open="MenuDrawer-{{ section.id }}" aria-label="{{ 'general.accessibility.menu' | t }}">
            {%- render 'icon', name: 'menu' -%}
          </button>
          <a class="header__logo-link" href="{{ routes.root_url }}">
            {%- render 'logo', width: section.settings.logo_width, inverted: false, show_tagline: false -%}
          </a>
        {%- when 'logo-center' -%}
          <button type="button" class="header__icon header__menu-btn hide-desktop" data-panel-open="MenuDrawer-{{ section.id }}" aria-label="{{ 'general.accessibility.menu' | t }}">
            {%- render 'icon', name: 'menu' -%}
          </button>
          {%- render 'header-nav',
            menu: menu,
            class: 'header-nav hide-mobile',
            mega_columns: section.settings.mega_columns,
            mega_menus: section.settings.mega_menus,
            show_menu_images: section.settings.show_menu_images,
            promo_image: section.settings.menu_promo_image,
            promo_link: section.settings.menu_promo_link,
            promo_eyebrow: section.settings.menu_promo_eyebrow,
            promo_heading: section.settings.menu_promo_heading
          -%}
        {%- else -%}
          <button type="button" class="header__icon header__menu-btn hide-desktop" data-panel-open="MenuDrawer-{{ section.id }}" aria-label="{{ 'general.accessibility.menu' | t }}">
            {%- render 'icon', name: 'menu' -%}
          </button>
          <a class="header__logo-link" href="{{ routes.root_url }}">
            {%- render 'logo', width: section.settings.logo_width, inverted: false, show_tagline: false -%}
          </a>
      {%- endcase -%}
    </div>

    {%- comment -%} ---------------- CENTRE ---------------- {%- endcomment -%}
    <div class="header__cell header__cell--center">
      {%- case layout -%}
        {%- when 'logo-center' -%}
          <a class="header__logo-link" href="{{ routes.root_url }}">
            {%- render 'logo', width: section.settings.logo_width, inverted: false, show_tagline: false -%}
          </a>
        {%- when 'nav-below' -%}
          {%- if section.settings.show_search and section.settings.search_style == 'inline' -%}
            {%- render 'predictive-search', id: 'header-search', class: 'header__search hide-mobile' -%}
          {%- endif -%}
        {%- else -%}
          {%- render 'header-nav',
            menu: menu,
            class: 'header-nav hide-mobile',
            mega_columns: section.settings.mega_columns,
            mega_menus: section.settings.mega_menus,
            show_menu_images: section.settings.show_menu_images,
            promo_image: section.settings.menu_promo_image,
            promo_link: section.settings.menu_promo_link,
            promo_eyebrow: section.settings.menu_promo_eyebrow,
            promo_heading: section.settings.menu_promo_heading
          -%}
      {%- endcase -%}
    </div>

    {%- comment -%} ---------------- RIGHT ---------------- {%- endcomment -%}
    <div class="header__cell header__cell--right">
      {%- if section.settings.show_phone and settings.contact_phone != blank -%}
        <a class="header__phone hide-mobile" href="tel:{{ settings.contact_phone | remove: ' ' | escape }}">
          {%- render 'icon', name: 'phone', size: 17 -%}
          <span>{{ settings.contact_phone | escape }}</span>
        </a>
      {%- endif -%}

      {%- if section.settings.show_search -%}
        {%- if section.settings.search_style == 'inline' and layout != 'nav-below' -%}
          <div class="header__search-inline hide-mobile">
            {%- render 'predictive-search', id: 'header-search', class: 'header__search' -%}
          </div>
        {%- else -%}
          <button type="button" class="header__icon" data-panel-open="SearchDrawer-{{ section.id }}" aria-label="{{ 'general.accessibility.search' | t }}">
            {%- render 'icon', name: 'search' -%}
          </button>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_account -%}
        <a class="header__icon" href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" aria-label="{{ 'sections.header.account' | t }}">
          {%- render 'icon', name: 'user' -%}
        </a>
      {%- endif -%}

      {%- if section.settings.show_cart -%}
        {%- if settings.cart_type == 'page' -%}
          <a class="header__icon header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'general.accessibility.cart' | t }}">
        {%- else -%}
          <button type="button" class="header__icon header__cart" data-panel-open="CartDrawer" aria-label="{{ 'general.accessibility.cart' | t }}">
        {%- endif -%}
            {%- render 'icon', name: section.settings.cart_icon -%}
            <span class="cart-bubble" data-cart-bubble {% if cart.item_count == 0 %}hidden{% endif %}>
              <span data-cart-count>{{ cart.item_count }}</span>
            </span>
        {%- if settings.cart_type == 'page' -%}</a>{%- else -%}</button>{%- endif -%}
      {%- endif -%}
    </div>
  </div>

  {%- if layout == 'nav-below' -%}
    <div class="header__second-row hide-mobile">
      <div class="container">
        {%- render 'header-nav',
          menu: menu,
          class: 'header-nav header-nav--centered',
          mega_columns: section.settings.mega_columns,
          mega_menus: section.settings.mega_menus,
          show_menu_images: section.settings.show_menu_images,
          promo_image: section.settings.menu_promo_image,
          promo_link: section.settings.menu_promo_link,
          promo_eyebrow: section.settings.menu_promo_eyebrow,
          promo_heading: section.settings.menu_promo_heading
        -%}
      </div>
    </div>
  {%- endif -%}
</header>

{%- comment -%} ---------------- mobile menu drawer ---------------- {%- endcomment -%}
<div class="overlay" data-shared-overlay data-overlay-close aria-hidden="true"></div>

<div class="drawer drawer--left mobile-menu color-scheme-{{ scheme }}" id="MenuDrawer-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'general.accessibility.menu' | t }}" aria-hidden="true" tabindex="-1">
  <div class="drawer__header">
    <span class="drawer__title">
      {%- if settings.logo != blank -%}
        {%- assign mobile_logo_width = section.settings.logo_width | divided_by: 1.5 | round -%}
        {%- render 'logo', width: mobile_logo_width -%}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </span>
    <button type="button" class="drawer__close" data-panel-close aria-label="{{ 'general.accessibility.close' | t }}">
      {%- render 'icon', name: 'close', size: 20 -%}
    </button>
  </div>

  <div class="drawer__body">
    {%- if section.settings.show_search -%}
      <div class="mobile-menu__search">
        {%- render 'predictive-search', id: 'drawer-search' -%}
      </div>
    {%- endif -%}

    <ul class="mobile-nav" role="list">
      {%- for link in menu.links -%}
        <li class="mobile-nav__item{% if link.active %} is-active{% endif %}">
          {%- if link.links.size > 0 -%}
            {%- assign panel_id = 'MobilePanel-' | append: section.id | append: '-' | append: forloop.index -%}
            <div class="mobile-nav__row">
              <a class="mobile-nav__link" href="{{ link.url }}">{{ link.title | escape }}</a>
              <button
                type="button"
                class="mobile-nav__toggle"
                data-menu-toggle
                aria-controls="{{ panel_id }}"
                aria-expanded="false"
                aria-label="{{ link.title | escape }}"
              >
                {%- render 'icon', name: 'chevron-down', size: 16 -%}
              </button>
            </div>
            <div class="mobile-nav__panel" id="{{ panel_id }}" style="max-height: 0;">
              <ul class="mobile-nav__sublist" role="list">
                {%- for child in link.links -%}
                  <li>
                    <a class="mobile-nav__sublink" href="{{ child.url }}">{{ child.title | escape }}</a>
                    {%- if child.links.size > 0 -%}
                      <ul class="mobile-nav__subsublist" role="list">
                        {%- for grand in child.links -%}
                          <li><a href="{{ grand.url }}">{{ grand.title | escape }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
                <li><a class="mobile-nav__all" href="{{ link.url }}">{{ 'collections.general.view_all' | t }} {%- render 'icon', name: 'arrow-right', size: 14 -%}</a></li>
              </ul>
            </div>
          {%- else -%}
            <a class="mobile-nav__link" href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.mobile_extra_menu != blank and linklists[section.settings.mobile_extra_menu].links.size > 0 -%}
      <div class="mobile-menu__divider"></div>
      <p class="eyebrow mobile-menu__label">{{ linklists[section.settings.mobile_extra_menu].title | escape }}</p>
      <ul class="mobile-nav mobile-nav--tight" role="list">
        {%- for link in linklists[section.settings.mobile_extra_menu].links -%}
          <li class="mobile-nav__item"><a class="mobile-nav__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_contact_block and settings.contact_phone != blank -%}
      <div class="mobile-menu__divider"></div>
      <div class="mobile-menu__contact">
        {%- if settings.contact_phone != blank -%}
          <a href="tel:{{ settings.contact_phone | remove: ' ' | escape }}">{%- render 'icon', name: 'phone', size: 17 -%} {{ settings.contact_phone | escape }}</a>
        {%- endif -%}
        {%- if settings.contact_email != blank -%}
          <a href="mailto:{{ settings.contact_email | escape }}">{%- render 'icon', name: 'mail', size: 17 -%} {{ settings.contact_email | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="drawer__footer">
    {%- render 'social-links', class: 'mobile-menu__social', size: 18 -%}
    <div class="mobile-menu__account">
      {%- if customer -%}
        <a class="btn btn--outline btn--small" href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a>
        <a class="btn btn--ghost btn--small" href="{{ routes.account_logout_url }}">{{ 'customer.account.log_out' | t }}</a>
      {%- else -%}
        <a class="btn btn--outline btn--small" href="{{ routes.account_login_url }}">{{ 'customer.login_page.sign_in' | t }}</a>
        <a class="btn btn--ghost btn--small" href="{{ routes.account_register_url }}">{{ 'customer.login_page.create_account' | t }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%} ---------------- search drawer ---------------- {%- endcomment -%}
{%- if section.settings.show_search -%}
  <div class="drawer drawer--search color-scheme-{{ scheme }}" id="SearchDrawer-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'general.accessibility.search' | t }}" aria-hidden="true" tabindex="-1">
    <div class="drawer__header">
      <span class="drawer__title h3">{{ 'general.search.search' | t }}</span>
      <button type="button" class="drawer__close" data-panel-close aria-label="{{ 'general.accessibility.close' | t }}">
        {%- render 'icon', name: 'close', size: 20 -%}
      </button>
    </div>
    <div class="drawer__body">
      {%- render 'predictive-search', id: 'search-drawer', large: true -%}

      {%- if section.settings.search_suggestions != blank -%}
        <div class="search-drawer__popular">
          <p class="eyebrow">{{ section.settings.search_suggestions_heading | default: 'Popular searches' | escape }}</p>
          <div class="search-drawer__tags">
            {%- assign tags = section.settings.search_suggestions | split: ',' -%}
            {%- for tag in tags -%}
              {%- assign clean = tag | strip -%}
              {%- if clean != blank -%}
                <a class="chip" href="{{ routes.search_url }}?q={{ clean | url_encode }}">{{ clean | escape }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.search_collection != blank -%}
        <div class="search-drawer__feature">
          <p class="eyebrow">{{ section.settings.search_feature_heading | default: 'Start here' | escape }}</p>
          <a class="search-drawer__card" href="{{ section.settings.search_collection.url }}">
            {%- if section.settings.search_collection.featured_image != blank -%}
              <span class="media media--4-5">
                <img src="{{ section.settings.search_collection.featured_image | image_url: width: 480 }}" alt="{{ section.settings.search_collection.featured_image.alt | escape }}" loading="lazy">
              </span>
            {%- endif -%}
            <span>{{ section.settings.search_collection.title | escape }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
/* ------------------------------------------------------------- header --- */
.header-section,
.shopify-section-group-header-group { position: relative; z-index: 40; }

body.header-is-sticky .shopify-section-group-header-group,
body.header-is-sticky .header-section {
  position: sticky;
  top: 0;
  z-index: 40;
}

body.header-is-hide { padding-top: var(--header-height, 0px); }

body.header-is-hide .shopify-section-group-header-group,
body.header-is-hide .header-section {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  transition: transform 0.4s var(--ease);
}

body.header-is-hide .shopify-section-group-header-group.is-hidden,
body.header-is-hide .header-section.is-hidden { transform: translateY(-101%); }

.header {
  background: var(--bg);
  color: var(--text);
  border-bottom: 0 solid transparent;
  transition: box-shadow 0.3s var(--ease), background-color 0.3s var(--ease), padding 0.3s var(--ease);
}

.header--bordered { border-bottom-width: var(--border-width); border-bottom-color: var(--border); }

.header.is-stuck { box-shadow: 0 6px 24px rgba(0, 0, 0, 0.07); }

.header__inner {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 1rem;
  padding-block: var(--header-padding, 16px);
  min-height: 3.4rem;
}

.header--logo-left .header__inner { grid-template-columns: auto 1fr auto; }
.header--nav-below .header__inner { grid-template-columns: auto 1fr auto; }
.header--logo-center .header__cell--center { text-align: center; }

.header__cell { display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
.header__cell--left { justify-self: start; }
.header__cell--center { justify-self: center; }
.header__cell--right { justify-self: end; margin-left: auto; }

.header--logo-left .header__cell--left { gap: 1.2rem; }
.header--logo-left .header-nav { margin-left: 0.8rem; }

.header__icon {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  color: inherit;
  transition: background-color 0.25s var(--ease), color 0.25s var(--ease), transform 0.25s var(--ease);
}

.header__icon:hover { background: var(--hover-tint); color: var(--accent); }

.header__phone {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-size: var(--body-size-small);
  margin-right: 0.6rem;
  color: var(--text-muted);
}

.header__phone:hover { color: var(--accent); }

.cart-bubble {
  position: absolute;
  top: 2px;
  right: 0;
  min-width: 1.05rem;
  height: 1.05rem;
  padding: 0 0.24rem;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background: var(--accent);
  color: var(--on-accent);
  font-size: 0.62rem;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0;
}

.cart-bubble[hidden] { display: none; }

.header__logo-link { display: inline-flex; align-items: center; max-width: 100%; }

.logo { display: inline-flex; flex-direction: column; align-items: center; line-height: 1; }
.header--logo-left .logo { align-items: flex-start; }
.logo__image { max-width: var(--logo-width, 170px); width: var(--logo-width, 170px); height: auto; transition: max-height 0.3s var(--ease); }
.logo__text {
  font-family: var(--font-heading);
  font-size: clamp(1.05rem, 0.7rem + 1.1vw, 1.6rem);
  letter-spacing: var(--heading-letter-spacing);
  line-height: 1.15;
  text-align: center;
  white-space: nowrap;
}
.logo__tagline {
  font-family: var(--font-eyebrow);
  font-size: calc(var(--eyebrow-size) * 0.85);
  letter-spacing: var(--eyebrow-letter-spacing);
  text-transform: var(--eyebrow-case);
  color: var(--text-muted);
  margin-top: 0.25rem;
}

.header--compact.is-stuck .header__inner { padding-block: calc(var(--header-padding, 16px) * 0.5); }
.header--compact.is-stuck .logo__image { max-height: 32px; width: auto; }

.header__second-row { border-top: var(--border-width) solid var(--border); padding-block: 0.4rem; }

/* desktop nav ----------------------------------------------------------- */
.header-nav { display: block; }

.nav {
  display: flex;
  align-items: center;
  gap: clamp(0.6rem, 0.2rem + 1vw, 1.6rem);
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav--centered,
.header-nav--centered .nav { justify-content: center; }

.nav__item { position: relative; margin: 0; }

.nav__link {
  display: inline-flex;
  align-items: center;
  gap: 0.3em;
  padding: 0.55rem 0.15rem;
  font-family: var(--font-eyebrow);
  font-size: calc(var(--eyebrow-size) * 1.02);
  font-weight: 600;
  letter-spacing: var(--eyebrow-letter-spacing);
  text-transform: var(--eyebrow-case);
  color: var(--text);
  position: relative;
}

.nav__link::after {
  content: '';
  position: absolute;
  left: 0;
  right: 100%;
  bottom: 0.25rem;
  height: 1px;
  background: var(--accent);
  transition: right 0.35s var(--ease);
}

.nav__link:hover::after,
.nav__item.is-active > .nav__link::after,
.nav__item.is-open > .nav__link::after { right: 0.15rem; }

.nav__link:hover { color: var(--accent); }
.nav__item.is-open > .nav__link { color: var(--accent); }
.nav__link .icon__svg { transition: transform 0.3s var(--ease); }
.nav__item.is-open > .nav__link .icon__svg { transform: rotate(180deg); }

/* dropdown */
.nav__panel {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translate(-50%, 8px);
  min-width: 15rem;
  padding-top: 0.7rem;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.28s var(--ease), transform 0.28s var(--ease), visibility 0.28s;
  z-index: 50;
}

.nav__panel--mega {
  left: 50%;
  min-width: min(72rem, 92vw);
}

.nav__item:hover > .nav__panel,
.nav__item:focus-within > .nav__panel,
.nav__item.is-open > .nav__panel {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, 0);
}

.nav__panel-inner {
  background: var(--bg);
  color: var(--text);
  border: var(--border-width) solid var(--border);
  border-radius: var(--card-radius);
  box-shadow: var(--card-shadow-hover);
  padding: 1.4rem 1.6rem;
  display: flex;
  gap: 2rem;
  max-width: none;
}

.nav__columns {
  display: grid;
  grid-template-columns: repeat(var(--nav-columns, 4), minmax(0, 1fr));
  gap: 1.8rem;
  list-style: none;
  margin: 0;
  padding: 0;
  flex: 1 1 auto;
}

.nav__column { margin: 0; }

.nav__column-title {
  display: block;
  font-family: var(--font-eyebrow);
  font-size: var(--eyebrow-size);
  font-weight: 700;
  letter-spacing: var(--eyebrow-letter-spacing);
  text-transform: var(--eyebrow-case);
  color: var(--accent);
  margin-bottom: 0.7rem;
}

.nav__sublist { list-style: none; margin: 0; padding: 0; }
.nav__sublist li { margin: 0 0 0.4rem; }

.nav__sublink {
  font-size: var(--body-size-small);
  color: var(--text-muted);
  display: inline-block;
  padding: 0.15rem 0;
}

.nav__sublink:hover { color: var(--accent); transform: translateX(2px); }
.nav__sublink--single { color: var(--text); font-size: var(--body-size); }

.nav__promo { display: block; margin-top: 0.8rem; }
.nav__promo-media {
  display: block;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  border-radius: var(--image-radius);
}
.nav__promo-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
.nav__promo:hover .nav__promo-media img { transform: scale(1.06); }

.nav__banner {
  flex: 0 0 16rem;
  position: relative;
  display: block;
  border-radius: var(--card-radius);
  overflow: hidden;
}
.nav__banner-media { display: block; aspect-ratio: 4 / 5; }
.nav__banner-media img { width: 100%; height: 100%; object-fit: cover; }
.nav__banner-text {
  position: absolute;
  inset: auto 0 0 0;
  padding: 1.4rem 1.1rem 1.1rem;
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  color: #fff;
  background: linear-gradient(to top, rgba(12,9,6,0.82), transparent);
}
.nav__banner-text .eyebrow { color: rgba(255,255,255,0.82); margin: 0; }
.nav__banner-text .h4 { margin: 0; font-size: 1.05rem; }

/* mobile menu ----------------------------------------------------------- */
.mobile-menu__search { margin-bottom: 1.4rem; }

.mobile-nav { list-style: none; margin: 0; padding: 0; }
.mobile-nav--tight .mobile-nav__link { font-size: var(--body-size); }

.mobile-nav__item { margin: 0; border-bottom: var(--border-width) solid var(--border); }
.mobile-nav__item:last-child { border-bottom: 0; }

.mobile-nav__row { display: flex; align-items: center; gap: 0.5rem; }
.mobile-nav__row .mobile-nav__link { flex: 1 1 auto; }

.mobile-nav__link {
  display: block;
  padding: 0.95rem 0;
  font-family: var(--font-heading);
  font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.35rem);
  line-height: 1.3;
}

.mobile-nav__item.is-active > .mobile-nav__row .mobile-nav__link,
.mobile-nav__item.is-active > .mobile-nav__link { color: var(--accent); }

.mobile-nav__toggle {
  display: grid;
  place-items: center;
  width: 2.4rem;
  height: 2.4rem;
  color: var(--text-muted);
  transition: transform 0.3s var(--ease);
}

.mobile-nav__toggle[aria-expanded="true"] { transform: rotate(180deg); color: var(--accent); }

.mobile-nav__panel {
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.38s var(--ease);
}

.mobile-nav__sublist { list-style: none; margin: 0 0 0.9rem; padding: 0 0 0 0.9rem; border-left: var(--border-width) solid var(--border); }
.mobile-nav__sublist li { margin: 0; }
.mobile-nav__sublink { display: block; padding: 0.4rem 0; font-size: var(--body-size-small); color: var(--text-muted); }
.mobile-nav__sublink:hover { color: var(--accent); }
.mobile-nav__subsublist { list-style: none; margin: 0 0 0.4rem; padding-left: 0.9rem; }
.mobile-nav__subsublist a { font-size: var(--body-size-small); color: var(--text-faint); display: block; padding: 0.2rem 0; }
.mobile-nav__all { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 0; color: var(--accent); font-size: var(--body-size-small); }

.mobile-menu__divider { height: var(--border-width); background: var(--border); margin: 1.6rem 0; }
.mobile-menu__label { margin-bottom: 0.6rem; }
.mobile-menu__contact { display: flex; flex-direction: column; gap: 0.7rem; font-size: var(--body-size-small); }
.mobile-menu__contact a { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--text-muted); }
.mobile-menu__contact a:hover { color: var(--accent); }

.mobile-menu__social { display: flex; gap: 1rem; list-style: none; margin: 0 0 1rem; padding: 0; justify-content: center; }
.mobile-menu__social a { color: var(--text-muted); }
.mobile-menu__social a:hover { color: var(--accent); }
.mobile-menu__account { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; }

/* search drawer --------------------------------------------------------- */
.drawer--search {
  top: 0;
  right: 0;
  left: 0;
  width: 100%;
  height: auto;
  max-height: 92vh;
  border-left: 0;
  border-bottom: var(--border-width) solid var(--border);
  transform: translateY(-102%);
  box-shadow: 0 24px 60px rgba(0,0,0,0.24);
}

.drawer--search.is-open { transform: none; }
.drawer--search .drawer__body { overflow: visible; }

.search-drawer__popular { margin-top: 1.8rem; }
.search-drawer__tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }

.chip {
  display: inline-flex;
  align-items: center;
  padding: 0.45em 1em;
  border: var(--border-width) solid var(--border);
  border-radius: 999px;
  font-size: var(--body-size-small);
  color: var(--text-muted);
  transition: border-color 0.25s var(--ease), color 0.25s var(--ease), background-color 0.25s var(--ease);
}

.chip:hover { border-color: var(--accent); color: var(--accent); background: rgba(var(--accent-rgb), 0.07); }

.search-drawer__feature { margin-top: 2rem; }
.search-drawer__card { display: flex; align-items: center; gap: 1rem; }
.search-drawer__card .media { width: 5.5rem; flex: none; }

@media (max-width: 989px) {
  .header__inner { grid-template-columns: auto 1fr auto; }
  .header__cell--center { display: none; }
  .header--logo-center .header__cell--center { display: flex; justify-content: center; }
  .header--logo-center .header__cell--left .header-nav { display: none; }
}

@media (max-width: 749px) {
  .header__inner { padding-block: calc(var(--header-padding, 16px) * 0.7); }
  .logo__text { font-size: 1.05rem; white-space: normal; }
  .header__phone { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "header-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
