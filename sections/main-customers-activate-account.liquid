{%- style -%}
  /* Section spacing — Theme settings › this section */
  #shopify-section-{{ section.id }} {
    --section-pad-top: {{ section.settings.padding_top }}px;
    --section-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}
<div class="section customer-section color-scheme-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="container container--narrow">
    <div class="customer-card">
      <h1 class="customer-card__title h2">{{ 'customer.activate_account.title' | t }}</h1>
      <p class="text-muted text-small">{{ 'customer.activate_account.subtext' | t }}</p>

      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">
            <ul>{%- for field in form.errors -%}<li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>{%- endfor -%}</ul>
          </div>
        {%- endif -%}

        <div class="field field--float">
          <input type="password" name="customer[password]" id="ActivatePassword" placeholder=" " autocomplete="new-password" required>
          <label class="field__label" for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
        </div>
        <div class="field field--float">
          <input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" placeholder=" " autocomplete="new-password" required>
          <label class="field__label" for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
        </div>

        <div class="customer-links">
          <button type="submit" class="btn">{{ 'customer.activate_account.submit' | t }}</button>
          <button type="submit" name="decline" class="btn btn--ghost">{{ 'customer.activate_account.cancel' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Activate account",
  "tag": "section",
  "class": "customer-activate-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "Scheme 1 — Ivory"
        },
        {
          "value": "2",
          "label": "Scheme 2 — Ink"
        },
        {
          "value": "3",
          "label": "Scheme 3 — Terracotta"
        },
        {
          "value": "4",
          "label": "Scheme 4 — Indigo"
        },
        {
          "value": "5",
          "label": "Scheme 5 — Marigold"
        },
        {
          "value": "6",
          "label": "Scheme 6 — Leaf"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "info": "Matches the global section spacing by default. On mobile this is scaled by the ratio in Theme settings › Layout.",
      "default": 96,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "info": "Matches the global section spacing by default. On mobile this is scaled by the ratio in Theme settings › Layout.",
      "default": 96,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    }
  ]
}
{% endschema %}
