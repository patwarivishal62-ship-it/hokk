{%- comment -%}
  Rich text — a typographic statement block.
{%- endcomment -%}
{%- style -%}
  /* Section spacing — Theme settings › this section */
  #shopify-section-{{ section.id }} {
    --section-pad-top: {{ section.settings.padding_top }}px;
    --section-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}
<div class="rich-text section color-scheme-{{ section.settings.color_scheme }} rich-text--{{ section.settings.text_width }} rich-text--align-{{ section.settings.text_alignment }}" data-section-id="{{ section.id }}">
  <div class="container">
    {%- if section.settings.show_motif and settings.motif_enable -%}
      <div class="motif-row">{%- render 'motif', style: settings.motif_style -%}</div>
    {%- endif -%}

    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      {%- case section.settings.heading_tag -%}
        {%- when 'h1' -%}<h1 class="rich-text__heading">{{ section.settings.heading | escape }}</h1>
        {%- when 'h3' -%}<h3 class="rich-text__heading">{{ section.settings.heading | escape }}</h3>
        {%- when 'p' -%}<p class="rich-text__heading">{{ section.settings.heading | escape }}</p>
        {%- else -%}<h2 class="rich-text__heading">{{ section.settings.heading | escape }}</h2>
      {%- endcase -%}
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="rich-text__body rte rte--{{ section.settings.text_size }}">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="rich-text__action">
        <a class="btn{% if section.settings.button_style == 'outline' %} btn--outline{% endif %}{% if section.settings.button_style == 'ghost' %} btn--ghost{% endif %}" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.rich-text .container > * + * { margin-top: 1.1rem; }
.rich-text--narrow .container > * { max-width: 46rem; }
.rich-text--medium .container > * { max-width: 58rem; }
.rich-text--wide .container > * { max-width: 74rem; }

.rich-text--align-center .container > * { margin-inline: auto; text-align: center; }
.rich-text--align-center .motif-row { justify-content: center; }
.rich-text--align-right .container > * { margin-inline: 0 0 0 auto; text-align: right; }
.rich-text--align-right .motif-row { justify-content: flex-end; }

.rich-text__heading {
  font-size: clamp(1.6rem, 1.1rem + 2.4vw, var(--h2));
  line-height: 1.16;
  margin: 0;
  text-wrap: balance;
}
.rich-text__body { color: var(--text-muted); }
.rich-text__body.rte--large { font-size: calc(var(--body-size) * 1.18); line-height: 1.62; }
.rich-text__body.rte--small { font-size: var(--body-size-small); }
.rich-text__action { margin-top: 1.8rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "rich-text-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "Scheme 1 — Ivory"
        },
        {
          "value": "2",
          "label": "Scheme 2 — Ink"
        },
        {
          "value": "3",
          "label": "Scheme 3 — Terracotta"
        },
        {
          "value": "4",
          "label": "Scheme 4 — Indigo"
        },
        {
          "value": "5",
          "label": "Scheme 5 — Marigold"
        },
        {
          "value": "6",
          "label": "Scheme 6 — Leaf"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Slow-made objects for everyday rituals"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading size",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "Large (H1)"
        },
        {
          "value": "h2",
          "label": "Medium (H2)"
        },
        {
          "value": "h3",
          "label": "Small (H3)"
        },
        {
          "value": "p",
          "label": "Paragraph style"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every Kala Katha piece begins in a workshop, not a factory. We work with 40 artisan families across Rajasthan, Gujarat and Bengal — paying fair rates, publishing the maker's name, and refusing to rush a finish that needs another week in the sun.</p>"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "default": "regular",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "regular",
          "label": "Regular"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_width",
      "label": "Content width",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_motif",
      "label": "Show decorative motif",
      "default": true
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "outline",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "ghost",
          "label": "Text"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "info": "Matches the global section spacing by default. On mobile this is scaled by the ratio in Theme settings › Layout.",
      "default": 96,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "info": "Matches the global section spacing by default. On mobile this is scaled by the ratio in Theme settings › Layout.",
      "default": 96,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
