{%- comment -%}
  Gallery / lookbook — an editorial image wall with optional captions and lightbox.
{%- endcomment -%}
{%- liquid
  assign columns = section.settings.columns_desktop
  assign cols_mobile = section.settings.columns_mobile
  assign gap = section.settings.spacing
-%}
<div class="gallery section color-scheme-{{ section.settings.color_scheme }} gallery--{{ section.settings.layout }}" data-section-id="{{ section.id }}">
  <div class="{% if section.settings.full_width %}container-fluid{% else %}container{% endif %}">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      {%- render 'section-header',
        eyebrow: section.settings.eyebrow,
        title: section.settings.heading,
        text: section.settings.text,
        align: section.settings.header_alignment,
        action_label: section.settings.action_label,
        action_link: section.settings.action_link,
        show_motif: section.settings.show_motif,
        animate: true
      -%}
    {%- endif -%}

    <div class="gallery__grid" style="--cols: {{ columns }}; --cols-mobile: {{ cols_mobile }}; --gutter: {{ gap }}px;">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tall = false
          if block.settings.tall
            assign tall = true
          endif
          assign wide = false
          if block.settings.wide
            assign wide = true
          endif
        -%}
        <figure class="gallery__item{% if tall %} gallery__item--tall{% endif %}{% if wide %} gallery__item--wide{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a class="gallery__link" href="{{ block.settings.link }}">{%- endif -%}
            <span class="gallery__media media{% if block.settings.arch %} arch{% endif %}{% if section.settings.rounded %} media--rounded{% endif %}" style="aspect-ratio: {{ block.settings.ratio | default: section.settings.ratio }};" {% if section.settings.lightbox and block.settings.link == blank %}data-lightbox="{{ block.settings.image | image_url: width: 1600 }}" data-lightbox-caption="{{ block.settings.caption | escape }}"{% endif %}>
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 1100 }} 1100w"
                  sizes="(max-width: 749px) 46vw, {{ 100 | divided_by: columns }}vw"
                  alt="{{ block.settings.image.alt | default: block.settings.caption | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                  decoding="async"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              {%- if block.settings.caption != blank -%}
                <figcaption class="gallery__caption">{{ block.settings.caption | escape }}</figcaption>
              {%- endif -%}

              {%- if block.settings.product != blank and section.settings.show_product_link -%}
                <a class="gallery__shop" href="{{ block.settings.product.url }}">
                  {%- render 'icon', name: 'bag', size: 15 -%}
                  <span>{{ block.settings.product.title | escape }}</span>
                </a>
              {%- endif -%}
            </span>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.gallery__grid {
  display: grid;
  grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
  grid-auto-rows: 180px;
  gap: var(--gutter, 14px);
  margin-top: 2.4rem;
  grid-auto-flow: dense;
}
.gallery--tall .gallery__grid { grid-auto-rows: 240px; }
.gallery--short .gallery__grid { grid-auto-rows: 130px; }

.gallery__item { margin: 0; grid-row: span 2; min-width: 0; }
.gallery__item--tall { grid-row: span 3; }
.gallery__item--wide { grid-column: span 2; }
.gallery--masonry .gallery__item { grid-row: span 2; }

.gallery__link { display: block; height: 100%; text-decoration: none; }
.gallery__media {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: var(--image-radius);
  background: var(--bg-card);
}
.gallery__media img,
.gallery__media .placeholder-svg { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.9s var(--ease); }
.gallery__item:hover .gallery__media img { transform: scale(1.06); }

.gallery__caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 2rem 1rem 0.9rem;
  color: #fff;
  font-family: var(--font-eyebrow);
  font-size: 0.68rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  background: linear-gradient(180deg, rgba(26, 22, 19, 0) 0%, rgba(26, 22, 19, 0.75) 100%);
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
}
.gallery__item:hover .gallery__caption,
.gallery__item:focus-within .gallery__caption { opacity: 1; transform: none; }

.gallery__shop {
  position: absolute;
  top: 0.8rem;
  right: 0.8rem;
  z-index: 3;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.4rem 0.8rem;
  border-radius: 999px;
  background: rgba(var(--color-ivory-rgb), 0.94);
  color: var(--color-ink);
  font-size: 0.74rem;
  text-decoration: none;
  max-width: 70%;
  box-shadow: var(--card-shadow);
}
.gallery__shop span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gallery__shop:hover { background: var(--accent); color: var(--bg); }

@media (max-width: 749px) {
  .gallery__grid { grid-template-columns: repeat(var(--cols-mobile, 2), minmax(0, 1fr)); grid-auto-rows: 140px; }
  .gallery__item--wide { grid-column: span 2; }
  .gallery__caption { opacity: 1; transform: none; }
}
@media (max-width: 549px) {
  .gallery__grid { grid-auto-rows: 120px; }
  .gallery__item--wide { grid-column: span 1; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Gallery",
  "tag": "section",
  "class": "gallery-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 — Ivory" },
        { "value": "2", "label": "Scheme 2 — Ink" },
        { "value": "3", "label": "Scheme 3 — Terracotta" },
        { "value": "4", "label": "Scheme 4 — Indigo" },
        { "value": "5", "label": "Scheme 5 — Marigold" },
        { "value": "6", "label": "Scheme 6 — Leaf" }
      ],
      "default": "1"
    },
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lookbook" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Winter 26, shot in Jaipur" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "split", "label": "Split" }
      ],
      "default": "split"
    },
    { "type": "text", "id": "action_label", "label": "Header link label" },
    { "type": "url", "id": "action_link", "label": "Header link" },
    { "type": "checkbox", "id": "show_motif", "label": "Show decorative motif", "default": true },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Row height",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "regular", "label": "Regular" },
        { "value": "tall", "label": "Tall" }
      ],
      "default": "regular"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Default image ratio",
      "options": [
        { "value": "3 / 4", "label": "Tall 3:4" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "16 / 9", "label": "Wide 16:9" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Gap between images",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    { "type": "checkbox", "id": "rounded", "label": "Rounded corners", "default": true },
    { "type": "checkbox", "id": "full_width", "label": "Full width (edge to edge)", "default": false },
    { "type": "checkbox", "id": "lightbox", "label": "Open images in a lightbox", "info": "Turned off for images with a link", "default": true },
    { "type": "checkbox", "id": "show_product_link", "label": "Show the linked product chip", "default": true }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "product", "id": "product", "label": "Product to link (optional)" },
        {
          "type": "select",
          "id": "ratio",
          "label": "Image ratio",
          "options": [
            { "value": "", "label": "Use section default" },
            { "value": "3 / 4", "label": "Tall 3:4" },
            { "value": "4 / 5", "label": "Portrait 4:5" },
            { "value": "1 / 1", "label": "Square" },
            { "value": "16 / 9", "label": "Wide 16:9" }
          ],
          "default": ""
        },
        { "type": "checkbox", "id": "tall", "label": "Span an extra row", "default": false },
        { "type": "checkbox", "id": "wide", "label": "Span two columns", "default": false },
        { "type": "checkbox", "id": "arch", "label": "Arch mask", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery",
      "blocks": [
        { "type": "image", "settings": { "caption": "Indigo, ninth dip", "tall": true, "wide": true } },
        { "type": "image", "settings": { "caption": "Brass thali" } },
        { "type": "image", "settings": { "caption": "Block table, Bagru" } },
        { "type": "image", "settings": { "caption": "Drying yard", "wide": true } },
        { "type": "image", "settings": { "caption": "Terracotta" } }
      ]
    }
  ]
}
{% endschema %}
