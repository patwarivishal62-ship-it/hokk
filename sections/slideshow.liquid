          "default": 45
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "House of Kala Katha",
            "heading": "Objects that carry a story",
            "subheading": "handmade in Jaipur since 1974",
            "text": "<p>Block-printed textiles, cast brass and slow pottery from families we have worked with for three generations.</p>",
