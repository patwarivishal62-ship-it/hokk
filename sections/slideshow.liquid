            { "value": "", "label": "Use section default" },
            { "value": "top-left", "label": "Top left" },
            { "value": "top-center", "label": "Top centre" },
            { "value": "top-right", "label": "Top right" },
            { "value": "center-left", "label": "Middle left" },
            { "value": "center-center", "label": "Middle centre" },
            { "value": "center-right", "label": "Middle right" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-center", "label": "Bottom centre" },
            { "value": "bottom-right", "label": "Bottom right" }
          ],
          "default": ""
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            { "value": "", "label": "Use section default" },
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Centre" },
            { "value": "right", "label": "Right" }
          ],
          "default": ""
        },
        {
          "type": "select",
          "id": "text_tone",
          "label": "Text tone",
          "options": [
            { "value": "auto", "label": "Auto (light text)" },
            { "value": "light", "label": "Dark text on a light wash" },
            { "value": "dark", "label": "Light text (forced)" }
          ],
          "default": "auto"
        },
        {
          "type": "range",
