{%- comment -%}
  Footer — belongs to the footer group.
  Everything is a block: text, menus, newsletter, contact, image, payment
  information and custom Liquid. Blocks can be reordered and removed freely.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme
  assign blocks = section.blocks.size
  assign cols = section.settings.columns
  if cols > blocks
    assign cols = blocks
  endif
  if cols < 1
    assign cols = 1
  endif
-%}

<footer class="footer color-scheme-{{ scheme }} section" data-section-id="{{ section.id }}" role="contentinfo">
  {%- if section.settings.show_motif and settings.motif_enable -%}
    <div class="footer__motif motif-row">{%- render 'motif', style: settings.motif_style -%}</div>
  {%- endif -%}

  {%- if blocks > 0 -%}
    <div class="container">
      <div class="footer__grid" style="--footer-columns: {{ cols }};">
        {%- for block in section.blocks -%}
          <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__rte rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.show_social -%}
                  {%- render 'social-links', class: 'footer__social', size: 18, show_text: block.settings.show_social_text -%}
                {%- endif -%}
                {%- if block.settings.show_logo -%}
                  <div class="footer__logo">{%- render 'logo', width: block.settings.logo_width -%}</div>
                {%- endif -%}
                {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                  <a class="btn btn--outline btn--small footer__cta" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
                {%- endif -%}

              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- assign fmenu = block.settings.menu -%}
                {%- if fmenu != blank and fmenu.links.size > 0 -%}
                  <ul class="footer__list" role="list">
                    {%- for link in fmenu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <ul class="footer__list footer__list--placeholder" role="list">
                    <li><a href="{{ routes.root_url }}">Add a menu in the block settings</a></li>
                  </ul>
                {%- endif -%}

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__rte rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- render 'newsletter-form',
                  id: 'footer-newsletter',
                  button_label: block.settings.button_label,
                  placeholder: block.settings.placeholder,
                  style: block.settings.form_style
                -%}

              {%- when 'contact' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                <ul class="footer__contact" role="list">
                  {%- if settings.contact_address != blank -%}
                    <li>
                      {%- render 'icon', name: 'pin', size: 16 -%}
                      <span>{{ settings.contact_address | newline_to_br }}</span>
                    </li>
                  {%- endif -%}
                  {%- if settings.contact_phone != blank -%}
                    <li>
                      {%- render 'icon', name: 'phone', size: 16 -%}
                      <a href="tel:{{ settings.contact_phone | remove: ' ' | escape }}">{{ settings.contact_phone | escape }}</a>
                    </li>
                  {%- endif -%}
                  {%- if settings.contact_email != blank -%}
                    <li>
                      {%- render 'icon', name: 'mail', size: 16 -%}
                      <a href="mailto:{{ settings.contact_email | escape }}">{{ settings.contact_email | escape }}</a>
                    </li>
                  {%- endif -%}
                  {%- if settings.contact_hours != blank -%}
                    <li>
                      {%- render 'icon', name: 'clock', size: 16 -%}
                      <span>{{ settings.contact_hours | newline_to_br }}</span>
                    </li>
                  {%- endif -%}
                </ul>
                {%- if block.settings.show_map_link and block.settings.map_url != blank -%}
                  <a class="link-arrow footer__map" href="{{ block.settings.map_url }}" target="_blank" rel="noopener">
                    {{ block.settings.map_label | default: 'Get directions' | escape }}
                    {%- render 'icon', name: 'arrow-right', size: 14 -%}
                  </a>
                {%- endif -%}

              {%- when 'image' -%}
                {%- if block.settings.image != blank -%}
                  <figure class="footer__figure">
                    <span class="media{% if block.settings.arch %} arch{% endif %}" style="aspect-ratio: {{ block.settings.ratio }};">
                      <img
                        src="{{ block.settings.image | image_url: width: 640 }}"
                        srcset="{{ block.settings.image | image_url: width: 320 }} 320w, {{ block.settings.image | image_url: width: 640 }} 640w"
                        sizes="(max-width: 749px) 90vw, 320px"
                        alt="{{ block.settings.image.alt | escape }}"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        loading="lazy"
                      >
                    </span>
                    {%- if block.settings.caption != blank -%}
                      <figcaption class="footer__caption">{{ block.settings.caption | escape }}</figcaption>
                    {%- endif -%}
                  </figure>
                {%- else -%}
                  <span class="media media--4-5">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>
                {%- endif -%}

              {%- when 'custom' -%}
                <div class="footer__custom">
                  {%- if block.settings.heading != blank -%}
                    <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
                  {%- endif -%}
                  {{ block.settings.code }}
                </div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_bottom_bar -%}
    <div class="footer__bottom container">
      <div class="footer__bottom-row">
        <p class="footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
          {%- if settings.brand_established != blank %} · {{ settings.brand_established | escape }}{% endif -%}
          {%- if section.settings.copyright_text != blank %} · {{ section.settings.copyright_text | escape }}{% endif -%}
        </p>

        {%- if section.settings.show_localization and localization.available_countries.size > 1 -%}
          {%- form 'localization', class: 'footer__localization', id: 'FooterLocalization' -%}
            <label class="visually-hidden" for="FooterCountry">Country/region</label>
            <div class="select-wrap">
              <select class="footer__select" id="FooterCountry" name="country_code" onchange="this.form.submit();">
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.show_payment -%}
          <ul class="footer__payment" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.bottom_menu != blank and linklists[section.settings.bottom_menu].links.size > 0 -%}
          <ul class="footer__bottom-menu" role="list">
            {%- for link in linklists[section.settings.bottom_menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if section.settings.show_theme_credit -%}
        <p class="footer__credit">Handcrafted with the Kala Katha theme · Powered by {{ powered_by_link }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</footer>

{% stylesheet %}
.footer { background: var(--bg); color: var(--text); padding-block: clamp(2.6rem, 1.8rem + 3vw, 5rem) 0; }
.footer__motif { margin-bottom: clamp(1.6rem, 1rem + 2vw, 3rem); }

.footer__grid {
  display: grid;
  grid-template-columns: repeat(var(--footer-columns, 4), minmax(0, 1fr));
  gap: clamp(1.8rem, 1.2rem + 2vw, 3.4rem);
  padding-bottom: clamp(2rem, 1.4rem + 2vw, 3.4rem);
}

.footer__block--text { grid-column: span 1; }
.footer__block--newsletter { grid-column: span min(2, var(--footer-columns, 4)); }

.footer__heading {
  font-family: var(--font-eyebrow);
  font-size: var(--eyebrow-size);
  font-weight: 700;
  letter-spacing: var(--eyebrow-letter-spacing);
  text-transform: var(--eyebrow-case);
  color: var(--accent);
  margin: 0 0 1rem;
}

.footer__rte { font-size: var(--body-size-small); color: var(--text-muted); }

.footer__list { list-style: none; margin: 0; padding: 0; }
.footer__list li { margin: 0 0 0.55rem; }
.footer__list a {
  font-size: var(--body-size-small);
  color: var(--text-muted);
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  transition: color 0.25s var(--ease), transform 0.25s var(--ease);
}
.footer__list a::before {
  content: '';
  width: 0;
  height: 1px;
  background: var(--accent);
  transition: width 0.3s var(--ease);
}
.footer__list a:hover { color: var(--accent); }
.footer__list a:hover::before { width: 0.9em; }
.footer__list--placeholder a { opacity: 0.55; font-style: italic; }

.footer__social { display: flex; flex-wrap: wrap; gap: 0.85rem; list-style: none; margin: 1.2rem 0 0; padding: 0; }
.footer__social a { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--text-muted); }
.footer__social a:hover { color: var(--accent); transform: translateY(-2px); }
.footer__social__label { font-size: var(--body-size-small); }

.footer__logo { margin-top: 1.2rem; }
.footer__logo .logo { align-items: flex-start; }
.footer__cta { margin-top: 1.2rem; }

.footer__contact { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.85rem; }
.footer__contact li { display: flex; gap: 0.7rem; align-items: flex-start; margin: 0; }
.footer__contact .icon { color: var(--accent); margin-top: 0.2rem; }
.footer__contact span, .footer__contact a { font-size: var(--body-size-small); color: var(--text-muted); }
.footer__contact a:hover { color: var(--accent); }
.footer__map { margin-top: 1.1rem; }

.footer__figure { margin: 0; }
.footer__figure .media { display: block; overflow: hidden; border-radius: var(--image-radius); }
.footer__figure img { width: 100%; height: 100%; object-fit: cover; }
.footer__caption { display: block; margin-top: 0.7rem; font-size: var(--body-size-small); color: var(--text-muted); font-style: italic; }

.footer__bottom { border-top: var(--border-width) solid var(--border); padding-block: 1.4rem; }

.footer__bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.4rem;
  flex-wrap: wrap;
}

.footer__copyright, .footer__credit { margin: 0; font-size: calc(var(--body-size-small) * 0.92); color: var(--text-muted); }
.footer__credit { margin-top: 0.8rem; text-align: center; opacity: 0.75; }
.footer__credit a { text-decoration: underline; text-underline-offset: 2px; }

.footer__payment { display: flex; gap: 0.45rem; list-style: none; margin: 0; padding: 0; align-items: center; }
.footer__payment .payment-icon { height: 1.55rem; width: auto; opacity: 0.85; }

.footer__bottom-menu { display: flex; gap: 1.1rem; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
.footer__bottom-menu a { font-size: calc(var(--body-size-small) * 0.95); color: var(--text-muted); }
.footer__bottom-menu a:hover { color: var(--accent); }

.footer__localization .select-wrap { display: inline-block; }
.footer__select {
  padding: 0.4em 2em 0.4em 0.8em;
  font-size: var(--body-size-small);
  background: transparent;
  border-color: var(--border);
  color: var(--text-muted);
  min-width: 12rem;
}

@media (max-width: 989px) {
  .footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .footer__block--newsletter { grid-column: span 2; }
}

@media (max-width: 549px) {
  .footer__grid { grid-template-columns: 1fr; gap: 2rem; }
  .footer__block--newsletter { grid-column: span 1; }
  .footer__bottom-row { justify-content: center; text-align: center; }
  .footer__copyright { text-align: center; width: 100%; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 — Ivory" },
        { "value": "2", "label": "Scheme 2 — Ink" },
        { "value": "3", "label": "Scheme 3 — Terracotta" },
        { "value": "4", "label": "Scheme 4 — Indigo" },
        { "value": "5", "label": "Scheme 5 — Marigold" },
        { "value": "6", "label": "Scheme 6 — Leaf" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "info": "How many blocks sit side by side on desktop.",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_motif",
      "label": "Show decorative motif above the footer",
      "default": true
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_bar",
      "label": "Show bottom bar",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Extra copyright text",
      "default": "All rights reserved"
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom menu",
      "info": "For privacy policy, terms and shipping links."
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country/currency selector",
      "info": "Requires more than one market in Shopify settings.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_theme_credit",
      "label": "Show theme credit line",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text and brand",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "House of Kala Katha" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We work with third-generation block printers, brass casters and weavers across Rajasthan. Every object leaves the studio with the name of the family that made it.</p>"
        },
        { "type": "checkbox", "id": "show_logo", "label": "Show logo", "default": false },
        { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 320, "step": 5, "unit": "px", "default": 150 },
        { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true },
        { "type": "checkbox", "id": "show_social_text", "label": "Show social labels", "default": false },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Anyone who subscribes is added to your customer list as “accepts marketing”." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the house" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>New drops, studio notes and first access to limited runs. One letter a month, never more.</p>"
        },
        { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Your email address" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
        {
          "type": "select",
          "id": "form_style",
          "label": "Form style",
          "options": [
            { "value": "inline", "label": "Field and button on one line" },
            { "value": "stacked", "label": "Stacked" },
            { "value": "underline", "label": "Underlined field" }
          ],
          "default": "inline"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Studio contact",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Address, phone, email and hours come from Theme settings → Contact and support."
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Visit the studio" },
        { "type": "checkbox", "id": "show_map_link", "label": "Show directions link", "default": true },
        { "type": "text", "id": "map_label", "label": "Directions link text", "default": "Get directions" },
        { "type": "url", "id": "map_url", "label": "Directions link URL" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "The studio in Jaipur" },
        { "type": "checkbox", "id": "arch", "label": "Arch mask", "default": false },
        {
          "type": "select",
          "id": "ratio",
          "label": "Image ratio",
          "options": [
            { "value": "1 / 1", "label": "Square" },
            { "value": "4 / 5", "label": "Portrait" },
            { "value": "3 / 4", "label": "Tall" },
            { "value": "16 / 9", "label": "Wide" }
          ],
          "default": "4 / 5"
        }
      ]
    },
    {
      "type": "custom",
      "name": "Custom Liquid",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        {
          "type": "liquid",
          "id": "code",
          "label": "Custom Liquid",
          "info": "Add app snippets, HTML or Liquid. Script tags are not allowed here.",
          "default": "<p class=\"footer__rte\">Custom footer content goes here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "settings": {
        "color_scheme": "2",
        "columns": 4,
        "show_motif": true,
        "show_bottom_bar": true,
        "show_payment": true
      },
      "blocks": [
        {
          "type": "text",
          "settings": {
            "heading": "House of Kala Katha",
            "show_social": true
          }
        },
        {
          "type": "menu",
          "settings": { "heading": "Shop" }
        },
        {
          "type": "menu",
          "settings": { "heading": "The house" }
        },
        {
          "type": "contact",
          "settings": { "heading": "Visit the studio" }
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
