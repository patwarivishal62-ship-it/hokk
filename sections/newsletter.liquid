{%- comment -%}
  Newsletter — email capture with an optional image panel and incentive copy.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout
  assign align = section.settings.text_alignment
-%}
{%- style -%}
  /* Section spacing — Theme settings › this section */
  #shopify-section-{{ section.id }} {
    --section-pad-top: {{ section.settings.padding_top }}px;
    --section-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}
<div class="newsletter-section section color-scheme-{{ section.settings.color_scheme }} newsletter-section--{{ layout }} newsletter-section--align-{{ align }}{% if section.settings.show_border %} newsletter-section--bordered{% endif %}" data-section-id="{{ section.id }}">
  {%- if section.settings.image != blank and layout != 'plain' -%}
    <div class="newsletter-section__media" aria-hidden="true">
      <img src="{{ section.settings.image | image_url: width: 1400 }}" srcset="{{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 1400 }} 1400w" sizes="{% if layout == 'split' %}50vw{% else %}100vw{% endif %}" alt="" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
      <span class="newsletter-section__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></span>
    </div>
  {%- endif -%}

  <div class="container">
    <div class="newsletter-section__inner">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="newsletter-section__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}

      {%- if section.settings.show_motif and settings.motif_enable -%}
        <div class="motif-row newsletter-section__motif">{%- render 'motif', style: settings.motif_style -%}</div>
      {%- endif -%}

      {%- if section.settings.text != blank -%}<div class="newsletter-section__text rte">{{ section.settings.text }}</div>{%- endif -%}

      <div class="newsletter-section__form">
        {%- render 'newsletter-form',
          id: 'Newsletter-' | append: section.id,
          button_label: section.settings.button_label,
          placeholder: section.settings.placeholder,
          style: section.settings.form_style
        -%}
      </div>

      {%- if section.settings.note != blank -%}
        <p class="newsletter-section__note text-small">{{ section.settings.note | escape }}</p>
      {%- endif -%}

      {%- if section.settings.show_social -%}
        {%- render 'social-links', style: 'icons' -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.newsletter-section { position: relative; overflow: hidden; isolation: isolate; }
.newsletter-section__media { position: absolute; inset: 0; z-index: -1; }
.newsletter-section__media img { width: 100%; height: 100%; object-fit: cover; }
.newsletter-section__overlay { position: absolute; inset: 0; background: var(--color-ink); }

.newsletter-section--split .newsletter-section__media { inset: 0 auto 0 50%; }
.newsletter-section--split .newsletter-section__inner { max-width: 34rem; margin-inline: 0 auto; text-align: left; }

.newsletter-section__inner { max-width: 42rem; margin-inline: auto; display: flex; flex-direction: column; gap: 1rem; }
.newsletter-section__heading { font-size: clamp(1.6rem, 1.2rem + 2vw, var(--h2)); margin: 0; line-height: 1.16; text-wrap: balance; }
.newsletter-section__text { color: var(--text-muted); margin: 0; }
.newsletter-section__motif { margin: 0.2rem 0; }
.newsletter-section__form { margin-top: 0.8rem; }
.newsletter-section__note { color: var(--text-muted); margin: 0; }

.newsletter-section--align-center { text-align: center; }
.newsletter-section--align-center .motif-row,
.newsletter-section--align-center .social-links { justify-content: center; }
.newsletter-section--align-left { text-align: left; }
.newsletter-section--align-left .motif-row,
.newsletter-section--align-left .social-links { justify-content: flex-start; }

.newsletter-section--bordered { border-top: var(--border-width) solid var(--border); border-bottom: var(--border-width) solid var(--border); }

.newsletter-section .social-links { margin-top: 1rem; }

@media (max-width: 989px) {
  .newsletter-section--split .newsletter-section__media { inset: 0; }
  .newsletter-section--split .newsletter-section__inner { max-width: none; margin-inline: auto; text-align: center; }
}
@media (max-width: 549px) {
  .newsletter-section .newsletter-form__row { flex-direction: column; }
  .newsletter-section .newsletter-form__button { width: 100%; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "newsletter-wrapper-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "5",
      "options": [
        {
          "value": "1",
          "label": "Scheme 1 — Ivory"
        },
        {
          "value": "2",
          "label": "Scheme 2 — Ink"
        },
        {
          "value": "3",
          "label": "Scheme 3 — Terracotta"
        },
        {
          "value": "4",
          "label": "Scheme 4 — Indigo"
        },
        {
          "value": "5",
          "label": "Scheme 5 — Marigold"
        },
        {
          "value": "6",
          "label": "Scheme 6 — Leaf"
        }
      ]
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Kala Katha letter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ten per cent off your first piece"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>One letter a month: new releases, the makers behind them, and first access to small runs.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_motif",
      "label": "Show decorative motif",
      "default": true
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "select",
      "id": "form_style",
      "label": "Form style",
      "default": "inline",
      "options": [
        {
          "value": "inline",
          "label": "Field and button side by side"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "underline",
          "label": "Underline only"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Field placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "No spam. Unsubscribe in one click."
    },
    {
      "type": "paragraph",
      "content": "Customers who subscribe are added to your “newsletter” customer segment."
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "plain",
      "options": [
        {
          "value": "plain",
          "label": "No image"
        },
        {
          "value": "full",
          "label": "Full-width image behind"
        },
        {
          "value": "split",
          "label": "Image on the right half"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "default": 60,
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show hairline borders above and below",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "info": "Matches the global section spacing by default. On mobile this is scaled by the ratio in Theme settings › Layout.",
      "default": 96,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "info": "Matches the global section spacing by default. On mobile this is scaled by the ratio in Theme settings › Layout.",
      "default": 96,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
