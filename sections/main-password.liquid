{%- comment -%}
  Password page section (used with layout/password.liquid).
{%- endcomment -%}
<div class="password-page color-scheme-{{ section.settings.color_scheme }}">
  {%- if section.settings.image != blank -%}
    <div class="password-page__media">
      <img
        src="{{ section.settings.image | image_url: width: 1200 }}"
        srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1800 }} 1800w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        loading="eager"
      >
      <span class="media-overlay media-overlay--flat"></span>
    </div>
  {%- endif -%}

  <div class="password-page__inner">
    <div class="password-page__content">
      <a class="password-page__logo" href="{{ routes.root_url }}">
        {%- render 'logo', width: section.settings.logo_width, show_tagline: true -%}
      </a>

      {%- if settings.motif_enable -%}
        <div class="motif-row">{%- render 'motif', style: settings.motif_style -%}</div>
      {%- endif -%}

      <p class="eyebrow eyebrow--center eyebrow--no-rule">{{ 'general.password_page.opening_soon' | t }}</p>

      <h1 class="password-page__title">
        {%- if section.settings.heading != blank -%}{{ section.settings.heading | escape }}{%- else -%}{{ shop.name | escape }}{%- endif -%}
      </h1>

      {%- if section.settings.text != blank -%}
        <div class="password-page__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="password-page__newsletter">
          {%- render 'newsletter-form', id: 'password-newsletter', style: section.settings.newsletter_style -%}
          <p class="text-small text-muted">{{ 'general.newsletter.info' | t }}</p>
        </div>
      {%- endif -%}

      {%- if section.settings.show_social -%}
        {%- render 'social-links', class: 'password-page__social', size: 20 -%}
      {%- endif -%}

      {%- if section.settings.show_password_form -%}
        <div class="password-page__enter">
          {%- form 'storefront_password', class: 'password-form' -%}
            <h2 class="password-form__title h4">{{ 'general.password_page.login_form_heading' | t }}</h2>
            {%- if form.errors -%}
              <p class="form-message form-message--error" role="alert">{{ 'general.password_page.login_form_error' | t }}</p>
            {%- endif -%}
            <div class="password-form__row">
              <div class="field field--float password-form__field">
                <input
                  type="password"
                  name="password"
                  id="Password"
                  placeholder=" "
                  autocomplete="current-password"
                >
                <label class="field__label" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
              </div>
              <button type="submit" class="btn">{{ 'general.password_page.login_form_submit' | t }}</button>
            </div>
          {%- endform -%}
        </div>
      {%- endif -%}

      <p class="password-page__admin">
        {{ 'general.password_page.admin_link_html' | t }}
        &nbsp;·&nbsp;
        {{ 'general.password_page.powered_by_shopify_html' | t: shopify: 'Shopify' }}
      </p>
    </div>
  </div>
</div>

{% stylesheet %}
.password-page { position: relative; min-height: 100vh; display: grid; place-items: center; overflow: hidden; }
.password-page__media { position: absolute; inset: 0; z-index: 0; }
.password-page__media img { width: 100%; height: 100%; object-fit: cover; }
.password-page__media .media-overlay { opacity: 0.62; }

.password-page__inner { position: relative; z-index: 1; width: 100%; padding: clamp(2rem, 1.4rem + 4vw, 5rem) var(--gutter); display: flex; justify-content: center; }
.password-page__content { width: 100%; max-width: 40rem; text-align: center; background: var(--bg); border: var(--card-border) solid var(--border); border-radius: var(--card-radius); box-shadow: var(--card-shadow-hover); padding: clamp(1.6rem, 1.2rem + 2.4vw, 3.2rem); }

.password-page__logo { display: inline-flex; justify-content: center; margin-bottom: 1rem; }
.password-page__logo .logo { align-items: center; }
.password-page__title { font-size: clamp(1.8rem, 1.2rem + 2.4vw, var(--h2)); margin: 0 0 0.8rem; }
.password-page__text { color: var(--text-muted); margin-bottom: 1.6rem; }
.password-page__newsletter { margin-top: 1.6rem; }
.password-page__newsletter .text-small { margin-top: 0.7rem; }
.password-page__social { display: flex; gap: 1rem; justify-content: center; list-style: none; margin: 1.6rem 0 0; padding: 0; }
.password-page__social a { color: var(--text-muted); }
.password-page__social a:hover { color: var(--accent); }

.password-page__enter { margin-top: 2rem; padding-top: 1.6rem; border-top: var(--border-width) solid var(--border); }
.password-form__title { margin-bottom: 1rem; }
.password-form__row { display: flex; gap: 0.6rem; align-items: stretch; }
.password-form__field { flex: 1 1 auto; margin-bottom: 0; }
@media (max-width: 549px) { .password-form__row { flex-direction: column; } }

.password-page__admin { margin-top: 2rem; font-size: calc(var(--body-size-small) * 0.92); color: var(--text-faint); }
.password-page__admin a { text-decoration: underline; text-underline-offset: 2px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "password-template-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 — Ivory" },
        { "value": "2", "label": "Scheme 2 — Ink" },
        { "value": "3", "label": "Scheme 3 — Terracotta" },
        { "value": "4", "label": "Scheme 4 — Indigo" },
        { "value": "5", "label": "Scheme 5 — Marigold" },
        { "value": "6", "label": "Scheme 6 — Leaf" }
      ],
      "default": "1"
    },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 320, "step": 10, "unit": "px", "default": 200 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something beautiful is being made" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The House of Kala Katha opens soon. Leave your email and we will tell you the day the doors open, with early access to the first run.</p>"
    },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    {
      "type": "select",
      "id": "newsletter_style",
      "label": "Newsletter style",
      "options": [
        { "value": "inline", "label": "Inline" },
        { "value": "stacked", "label": "Stacked" },
        { "value": "underline", "label": "Underlined" }
      ],
      "default": "inline"
    },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true },
    { "type": "checkbox", "id": "show_password_form", "label": "Show the password entry form", "default": true }
  ]
}
{% endschema %}
