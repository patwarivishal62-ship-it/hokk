{%- comment -%}
  Contact form — build your own form from blocks, with an optional details panel.
{%- endcomment -%}
{%- liquid
  assign uid = section.id
  assign form_id = 'ContactForm-' | append: section.id
  assign show_info = false
  if section.settings.info_title != blank or section.settings.info_address != blank or section.settings.info_phone != blank or section.settings.info_email != blank or section.settings.info_hours != blank
    assign show_info = true
  endif
  assign grid_class = 'contact-form__grid'
  if show_info == false
    assign grid_class = 'contact-form__grid contact-form__grid--single'
  endif
-%}

<div class="contact-form-section section color-scheme-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="container">
    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      title: section.settings.heading,
      text: section.settings.text,
      align: section.settings.header_alignment,
      show_motif: section.settings.show_motif,
      animate: true
    -%}

    <div class="{{ grid_class }} contact-form__grid--{{ section.settings.info_position }}">
      <div class="contact-form__panel">
        {%- form 'contact', id: form_id, class: 'contact-form', novalidate: 'novalidate' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status">
              {%- render 'icon', name: 'check-circle', size: 17 -%}
              {%- if section.settings.success_text != blank -%}
                {{ section.settings.success_text | escape }}
              {%- else -%}
                {{ 'contact.form.post_success' | t }}
              {%- endif -%}
            </p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>
              <p class="form-message__title">
                {%- render 'icon', name: 'alert', size: 17 -%}
                {{ 'contact.form.error_heading' | t }}
              </p>
              <ul class="form-message__list">
                {%- for field in form.errors.fields -%}
                  <li>{{ field }} — {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="contact-form__fields">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'text_field' -%}
                  {%- assign field_name = block.settings.name | default: block.settings.label -%}
                  <div class="field field--float{% if block.settings.half_width %} field--half{% else %} field--full{% endif %}" {{ block.shopify_attributes }}>
                    <input
                      type="{{ block.settings.type }}"
                      id="CF-{{ uid }}-{{ forloop.index }}"
                      name="contact[{{ field_name | escape }}]"
                      value=""
                      placeholder=" "
                      {% if block.settings.required %}required{% endif %}
                      {% if block.settings.type == 'email' %}autocomplete="email" inputmode="email"{% endif %}
                      {% if block.settings.type == 'tel' %}autocomplete="tel" inputmode="tel"{% endif %}
                    >
                    <label class="field__label" for="CF-{{ uid }}-{{ forloop.index }}">
                      {{ block.settings.label | escape }}{% if block.settings.required %}<span class="field__required" aria-hidden="true">*</span>{% endif %}
                    </label>
                  </div>

                {%- when 'textarea' -%}
                  {%- assign field_name = block.settings.name | default: 'body' -%}
                  <div class="field field--float field--full" {{ block.shopify_attributes }}>
                    <textarea
                      id="CF-{{ uid }}-{{ forloop.index }}"
                      name="contact[{{ field_name | escape }}]"
                      rows="{{ block.settings.rows }}"
                      placeholder=" "
                      {% if block.settings.required %}required{% endif %}
                    ></textarea>
                    <label class="field__label" for="CF-{{ uid }}-{{ forloop.index }}">
                      {{ block.settings.label | escape }}{% if block.settings.required %}<span class="field__required" aria-hidden="true">*</span>{% endif %}
                    </label>
                  </div>

                {%- when 'select' -%}
                  {%- assign field_name = block.settings.name | default: block.settings.label -%}
                  {%- assign choices = block.settings.options | split: ',' -%}
                  <div class="field field--full" {{ block.shopify_attributes }}>
                    <label for="CF-{{ uid }}-{{ forloop.index }}">
                      {{ block.settings.label | escape }}{% if block.settings.required %}<span class="field__required" aria-hidden="true">*</span>{% endif %}
                    </label>
                    <div class="select-wrap">
                      <select id="CF-{{ uid }}-{{ forloop.index }}" name="contact[{{ field_name | escape }}]" {% if block.settings.required %}required{% endif %}>
                        <option value="">{{ block.settings.placeholder | default: 'Please choose' | escape }}</option>
                        {%- for choice in choices -%}
                          <option value="{{ choice | strip | escape }}">{{ choice | strip | escape }}</option>
                        {%- endfor -%}
                      </select>
                    </div>
                  </div>

                {%- when 'checkbox' -%}
                  <div class="field field--full field--checkbox" {{ block.shopify_attributes }}>
                    <label class="checkbox">
                      <input type="checkbox" name="contact[{{ block.settings.name | default: block.settings.label | escape }}]" value="yes" {% if block.settings.required %}required{% endif %}>
                      <span>{{ block.settings.label | escape }}{% if block.settings.required %}<span class="field__required" aria-hidden="true">*</span>{% endif %}</span>
                    </label>
                  </div>

                {%- when 'paragraph' -%}
                  <div class="field field--full contact-form__note rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

                {%- when 'submit' -%}
                  <div class="field field--full contact-form__submit" {{ block.shopify_attributes }}>
                    <button type="submit" class="btn{% if block.settings.full_width %} btn--full{% endif %}{% if block.settings.style == 'outline' %} btn--outline{% endif %}">
                      {{ block.settings.label | default: 'Send message' | escape }}
                    </button>
                    {%- if block.settings.note != blank -%}
                      <p class="text-small text-muted contact-form__submit-note">{{ block.settings.note | escape }}</p>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endform -%}
      </div>

      {%- if show_info -%}
        <aside class="contact-form__info">
          {%- if section.settings.info_title != blank -%}<h3 class="contact-form__info-title">{{ section.settings.info_title | escape }}</h3>{%- endif -%}

          {%- if section.settings.info_address != blank -%}
            <div class="contact-form__info-row">
              <span class="contact-form__info-icon">{%- render 'icon', name: 'pin', size: 18 -%}</span>
              <div class="rte">{{ section.settings.info_address }}</div>
            </div>
          {%- endif -%}

          {%- if section.settings.info_phone != blank -%}
            <div class="contact-form__info-row">
              <span class="contact-form__info-icon">{%- render 'icon', name: 'phone', size: 18 -%}</span>
              <a class="link-plain" href="tel:{{ section.settings.info_phone | remove: ' ' | escape }}">{{ section.settings.info_phone | escape }}</a>
            </div>
          {%- endif -%}

          {%- if section.settings.info_email != blank -%}
            <div class="contact-form__info-row">
              <span class="contact-form__info-icon">{%- render 'icon', name: 'mail', size: 18 -%}</span>
              <a class="link-plain" href="mailto:{{ section.settings.info_email | escape }}">{{ section.settings.info_email | escape }}</a>
            </div>
          {%- endif -%}

          {%- if section.settings.info_hours != blank -%}
            <div class="contact-form__info-row">
              <span class="contact-form__info-icon">{%- render 'icon', name: 'clock', size: 18 -%}</span>
              <div class="rte">{{ section.settings.info_hours }}</div>
            </div>
          {%- endif -%}

          {%- if section.settings.info_image != blank -%}
            <a class="contact-form__map media" href="{{ section.settings.info_map_link | default: '#' }}" {% if section.settings.info_map_link contains 'http' %}target="_blank" rel="noopener"{% endif %}>
              <img src="{{ section.settings.info_image | image_url: width: 800 }}" srcset="{{ section.settings.info_image | image_url: width: 400 }} 400w, {{ section.settings.info_image | image_url: width: 800 }} 800w" sizes="(max-width: 989px) 92vw, 38vw" alt="{{ section.settings.info_image.alt | default: section.settings.info_title | escape }}" loading="lazy" width="{{ section.settings.info_image.width }}" height="{{ section.settings.info_image.height }}">
            </a>
          {%- endif -%}

          {%- if section.settings.show_social -%}
            {%- render 'social-links', size: 18 -%}
          {%- endif -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.contact-form__grid {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  gap: clamp(1.8rem, 5vw, 4rem);
  align-items: start;
  margin-top: 2.6rem;
}
.contact-form__grid--single { grid-template-columns: minmax(0, 1fr); max-width: 46rem; margin-inline: auto; }
.contact-form__grid--left .contact-form__info { order: -1; }

.contact-form__fields { display: flex; flex-wrap: wrap; gap: 1.2rem; }
.contact-form__fields > * { flex: 1 1 100%; }
.contact-form__fields .field--half { flex: 1 1 calc(50% - 0.6rem); }
.contact-form__fields .field--checkbox { flex: 1 1 100%; }

.contact-form__submit { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; margin-top: 0.4rem; }
.contact-form__submit-note { margin: 0; }

.contact-form__note { color: var(--text-muted); font-size: var(--body-size-small); }
.field__required { color: var(--color-sale); margin-left: 0.15em; }

.contact-form__info { display: flex; flex-direction: column; gap: 1.1rem; }
.contact-form__info-title { font-size: var(--h3); margin: 0; }
.contact-form__info-row { display: flex; gap: 0.8rem; align-items: flex-start; color: var(--text-muted); font-size: var(--body-size-small); }
.contact-form__info-row .rte p { margin: 0; }
.contact-form__info-row a { color: var(--text); text-decoration: none; }
.contact-form__info-row a:hover { color: var(--accent); }
.contact-form__info-icon { color: var(--accent); flex: none; margin-top: 0.1em; }
.contact-form__map { display: block; overflow: hidden; border-radius: var(--image-radius); aspect-ratio: 4 / 3; margin-top: 0.4rem; }
.contact-form__map img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s var(--ease); }
.contact-form__map:hover img { transform: scale(1.04); }

.form-message__title { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.4rem; font-weight: 600; }
.form-message__list { margin: 0; padding-left: 1.2rem; }
.form-message__list li { font-size: var(--body-size-small); }

@media (max-width: 989px) {
  .contact-form__grid,
  .contact-form__grid--left { grid-template-columns: 1fr; }
  .contact-form__grid--left .contact-form__info { order: 0; }
}
@media (max-width: 549px) {
  .contact-form__fields .field--half { flex: 1 1 100%; }
  .contact-form__submit .btn { width: 100%; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "contact-form-wrapper-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 — Ivory" },
        { "value": "2", "label": "Scheme 2 — Ink" },
        { "value": "3", "label": "Scheme 3 — Terracotta" },
        { "value": "4", "label": "Scheme 4 — Indigo" },
        { "value": "5", "label": "Scheme 5 — Marigold" },
        { "value": "6", "label": "Scheme 6 — Leaf" }
      ],
      "default": "1"
    },
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Write to us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We answer every message" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Custom orders, trade enquiries, repairs or a question about a piece you already own — tell us and we will reply within one working day.</p>" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "split", "label": "Split" }
      ],
      "default": "center"
    },
    { "type": "checkbox", "id": "show_motif", "label": "Show decorative motif", "default": true },
    { "type": "header", "content": "Messages" },
    { "type": "text", "id": "success_text", "label": "Success message", "info": "Leave blank to use the translation" },
    { "type": "header", "content": "Details panel" },
    {
      "type": "select",
      "id": "info_position",
      "label": "Panel position",
      "options": [
        { "value": "right", "label": "Right of the form" },
        { "value": "left", "label": "Left of the form" }
      ],
      "default": "right"
    },
    { "type": "text", "id": "info_title", "label": "Panel title", "default": "The house in Jaipur" },
    { "type": "richtext", "id": "info_address", "label": "Address", "default": "<p>14 Chandpol Bazaar, Jaipur<br>Rajasthan 302001, India</p>" },
    { "type": "text", "id": "info_phone", "label": "Phone", "default": "+91 98765 43210" },
    { "type": "text", "id": "info_email", "label": "Email", "default": "hello@houseofkalakatha.com" },
    { "type": "richtext", "id": "info_hours", "label": "Opening hours", "default": "<p>Monday to Saturday, 10am – 7pm IST</p>" },
    { "type": "image_picker", "id": "info_image", "label": "Map or storefront image" },
    { "type": "url", "id": "info_map_link", "label": "Map link" },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true }
  ],
  "blocks": [
    {
      "type": "text_field",
      "name": "Text field",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Name" },
        { "type": "text", "id": "name", "label": "Field name", "info": "Shown in the email you receive. Leave blank to use the label.", "default": "Name" },
        {
          "type": "select",
          "id": "type",
          "label": "Input type",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "email", "label": "Email" },
            { "value": "tel", "label": "Phone" },
            { "value": "number", "label": "Number" },
            { "value": "date", "label": "Date" }
          ],
          "default": "text"
        },
        { "type": "checkbox", "id": "half_width", "label": "Half width", "default": true },
        { "type": "checkbox", "id": "required", "label": "Required", "default": true }
      ]
    },
    {
      "type": "textarea",
      "name": "Message box",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Your message" },
        {
          "type": "text",
          "id": "name",
          "label": "Field name",
          "info": "Keep as “body” for the main message",
          "default": "body"
        },
        {
          "type": "range",
          "id": "rows",
          "label": "Rows",
          "min": 3,
          "max": 12,
          "step": 1,
          "default": 6
        },
        { "type": "checkbox", "id": "required", "label": "Required", "default": true }
      ]
    },
    {
      "type": "select",
      "name": "Dropdown",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "What is this about?" },
        { "type": "text", "id": "name", "label": "Field name", "default": "Enquiry type" },
        { "type": "textarea", "id": "options", "label": "Options (comma separated)", "default": "A custom order, An existing order, A repair, Wholesale, Something else" },
        { "type": "text", "id": "placeholder", "label": "Placeholder option", "default": "Please choose" },
        { "type": "checkbox", "id": "required", "label": "Required", "default": false }
      ]
    },
    {
      "type": "checkbox",
      "name": "Checkbox",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Send me the monthly letter as well" },
        { "type": "text", "id": "name", "label": "Field name", "default": "Newsletter opt-in" },
        { "type": "checkbox", "id": "required", "label": "Required", "default": false }
      ]
    },
    {
      "type": "paragraph",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We reply within one working day, Monday to Saturday.</p>"
        }
      ]
    },
    {
      "type": "submit",
      "name": "Submit button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "Send message" },
        {
          "type": "select",
          "id": "style",
          "label": "Button style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "solid"
        },
        { "type": "checkbox", "id": "full_width", "label": "Full width on mobile", "default": false },
        { "type": "text", "id": "note", "label": "Note beside the button", "default": "Or WhatsApp us on +91 98765 43210" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "blocks": [
        { "type": "text_field", "settings": { "label": "Name", "name": "Name", "type": "text", "half_width": true, "required": true } },
        { "type": "text_field", "settings": { "label": "Email", "name": "email", "type": "email", "half_width": true, "required": true } },
        { "type": "text_field", "settings": { "label": "Phone", "name": "Phone", "type": "tel", "half_width": true, "required": false } },
        { "type": "select", "settings": {} },
        { "type": "textarea", "settings": {} },
        { "type": "submit", "settings": {} }
      ]
    }
  ]
}
{% endschema %}
