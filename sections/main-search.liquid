{%- comment -%}
  Search results template section.
{%- endcomment -%}
{%- comment -%}
  The merchant decides which object types this store searches. The list is used
  twice: to skip results Liquid-side (a hard guarantee) and to build the
  `types=` parameter on the scope filter links.
{%- endcomment -%}
{%- liquid
  assign results_per_page = section.settings.results_per_page | default: 24
  assign allowed_types = ''
  if section.settings.show_products
    assign allowed_types = allowed_types | append: 'product,'
  endif
  if section.settings.show_articles
    assign allowed_types = allowed_types | append: 'article,'
  endif
  if section.settings.show_pages
    assign allowed_types = allowed_types | append: 'page,'
  endif
  assign types = allowed_types | split: ',' | compact | join: ','
-%}
{%- style -%}
  /* Section spacing — Theme settings › this section */
  #shopify-section-{{ section.id }} {
    --section-pad-top: {{ section.settings.padding_top }}px;
    --section-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}
<div class="section search-section color-scheme-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="container">
    {%- render 'breadcrumb' -%}

    <header class="page-header page-header--center search-section__header">
      <p class="eyebrow eyebrow--center">{{ 'general.search.search' | t }}</p>
      {%- if search.performed -%}
        <h1 class="page-header__title">{{ 'search.results_for' | t: terms: search.terms }}</h1>
        <p class="text-muted">{{ 'search.results_with_count' | t: count: search.results_count, terms: search.terms }}</p>
      {%- else -%}
        <h1 class="page-header__title">{{ 'search.title' | t }}</h1>
      {%- endif -%}
    </header>

    {%- if section.settings.show_scope_filter and search.performed and types != blank -%}
      {%- assign scope_query = search.terms | url_encode -%}
      <nav class="search-section__scopes" aria-label="{{ 'search.all_results' | t }}">
        <a class="chip" href="{{ routes.search_url }}?q={{ scope_query }}&types={{ types }}">{{ 'search.all_results' | t }}</a>
        {%- if section.settings.show_products -%}
          <a class="chip" href="{{ routes.search_url }}?q={{ scope_query }}&types=product">{{ 'search.products' | t }}</a>
        {%- endif -%}
        {%- if section.settings.show_articles -%}
          <a class="chip" href="{{ routes.search_url }}?q={{ scope_query }}&types=article">{{ 'search.articles' | t }}</a>
        {%- endif -%}
        {%- if section.settings.show_pages -%}
          <a class="chip" href="{{ routes.search_url }}?q={{ scope_query }}&types=page">{{ 'search.pages' | t }}</a>
        {%- endif -%}
      </nav>
    {%- endif -%}

    <div class="search-section__form container--narrow">
      {%- render 'predictive-search', id: 'search-page', large: true -%}
    </div>

    {%- if search.performed -%}
      {%- paginate search.results by results_per_page -%}
        {%- if search.results_count == 0 -%}
          <div class="collection-empty">
            <span class="motif">{%- render 'motif', style: settings.motif_style -%}</span>
            <h2 class="h3">{{ 'search.no_results' | t: terms: search.terms }}</h2>
            <p class="text-muted container--narrow">{{ section.settings.no_results_text | escape }}</p>
            <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
          </div>
        {%- else -%}
          <div class="grid search-grid" id="SearchGrid-{{ section.id }}" style="--cols: {{ section.settings.columns | default: 4 }}; --cols-tablet: 3; --cols-mobile: 2;">
            {%- for item in search.results -%}
              {%- assign out_of_scope = false -%}
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {%- unless section.settings.show_products -%}{%- assign out_of_scope = true -%}{%- endunless -%}
                {%- when 'article' -%}
                  {%- unless section.settings.show_articles -%}{%- assign out_of_scope = true -%}{%- endunless -%}
                {%- else -%}
                  {%- unless section.settings.show_pages -%}{%- assign out_of_scope = true -%}{%- endunless -%}
              {%- endcase -%}
              {%- unless out_of_scope -%}
              <div class="grid__item" data-load-item data-animate>
                {%- case item.object_type -%}
                  {%- when 'product' -%}
                    {%- render 'product-card', product: item, index: forloop.index, show_vendor: settings.search_show_vendor -%}
                  {%- when 'article' -%}
                    {%- render 'article-card', article: item, blog: item.blog, index: forloop.index, ratio: 'landscape' -%}
                  {%- else -%}
                    <article class="article-card card card--editorial search-page-card">
                      <div class="card__body">
                        <p class="eyebrow eyebrow--no-rule">{{ 'search.pages' | t }}</p>
                        <h3 class="article-card__title h4"><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
                        {%- if item.content != blank -%}
                          <div class="article-card__excerpt text-muted">{{ item.content | strip_html | truncatewords: 26 }}</div>
                        {%- endif -%}
                        <a class="link-arrow" href="{{ item.url }}">{{ 'collections.general.view_all' | t }} {%- render 'icon', name: 'arrow-right', size: 14 -%}</a>
                      </div>
                    </article>
                {%- endcase -%}
              </div>
              {%- endunless -%}
            {%- endfor -%}
          </div>

          {%- assign search_grid_id = '#SearchGrid-' | append: section.id -%}
          {%- render 'pagination', paginate: paginate, style: 'numbers', grid_id: search_grid_id -%}
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="search-section__suggest container--narrow">
        {%- if section.settings.suggestions != blank -%}
          <p class="eyebrow eyebrow--center">{{ section.settings.suggestions_heading | escape }}</p>
          <div class="search-drawer__tags" style="justify-content: center;">
            {%- assign tags = section.settings.suggestions | split: ',' -%}
            {%- for tag in tags -%}
              {%- assign clean = tag | strip -%}
              {%- if clean != blank -%}
                <a class="chip" href="{{ routes.search_url }}?q={{ clean | url_encode }}">{{ clean | escape }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.featured_collection != blank and section.settings.featured_collection.products_count > 0 -%}
          <div class="search-section__featured">
            {%- render 'section-header', title: section.settings.featured_heading, align: 'center' -%}
            <div class="grid" style="--cols: 4; --cols-tablet: 3; --cols-mobile: 2;">
              {%- for product in section.settings.featured_collection.products limit: 4 -%}
                <div class="grid__item" data-animate>{%- render 'product-card', product: product, index: forloop.index -%}</div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.search-section__header { margin-bottom: 1.6rem; }
.search-section__scopes { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin: 0 0 1.8rem; }
.search-section__form { margin-bottom: clamp(2rem, 1.4rem + 2vw, 3.4rem); }
.search-section__form .predictive__submit { display: none; }
.search-section__suggest { text-align: center; }
.search-section__featured { margin-top: clamp(2.4rem, 1.6rem + 3vw, 4rem); }
.search-page-card { border: var(--card-border) solid var(--border); border-radius: var(--card-radius); padding: 0.4rem; height: 100%; }
.search-page-card .card__body { padding: 1rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "class": "search-results-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "Scheme 1 — Ivory"
        },
        {
          "value": "2",
          "label": "Scheme 2 — Ink"
        },
        {
          "value": "3",
          "label": "Scheme 3 — Terracotta"
        },
        {
          "value": "4",
          "label": "Scheme 4 — Indigo"
        },
        {
          "value": "5",
          "label": "Scheme 5 — Marigold"
        },
        {
          "value": "6",
          "label": "Scheme 6 — Leaf"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Results per row",
      "default": "4",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ]
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "default": 24,
      "min": 6,
      "max": 48,
      "step": 6
    },
    {
      "type": "header",
      "content": "What to search"
    },
    {
      "type": "paragraph",
      "content": "Switch off anything this store does not want to return in search. Turned-off types are never rendered, even if the search query asks for them."
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Include products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_articles",
      "label": "Include journal articles",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pages",
      "label": "Include pages",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scope_filter",
      "label": "Show scope filter links",
      "info": "Everything · Products · Journal · Pages",
      "default": true
    },
    {
      "type": "text",
      "id": "no_results_text",
      "label": "No results text",
      "default": "Try a different word, or browse the whole house below."
    },
    {
      "type": "header",
      "content": "Before searching"
    },
    {
      "type": "text",
      "id": "suggestions_heading",
      "label": "Suggestions heading",
      "default": "Popular searches"
    },
    {
      "type": "text",
      "id": "suggestions",
      "label": "Suggestions",
      "info": "Comma separated.",
      "default": "Block print, Brass, Indigo, Table linen, Diwali gifts"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured collection"
    },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "Featured heading",
      "default": "Loved by the house"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "info": "Matches the global section spacing by default. On mobile this is scaled by the ratio in Theme settings › Layout.",
      "default": 96,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "info": "Matches the global section spacing by default. On mobile this is scaled by the ratio in Theme settings › Layout.",
      "default": 96,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    }
  ]
}
{% endschema %}
