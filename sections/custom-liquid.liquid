{%- comment -%}
  Custom Liquid — a free-form block for merchants who want to write their own HTML/Liquid.
{%- endcomment -%}
<div class="custom-liquid section color-scheme-{{ section.settings.color_scheme }}{% if section.settings.full_width %} custom-liquid--flush{% endif %}" data-section-id="{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <div class="container">
      {%- render 'section-header', eyebrow: section.settings.eyebrow, title: section.settings.heading, align: section.settings.header_alignment -%}
    </div>
  {%- endif -%}

  {%- if section.settings.wrap_in_container -%}<div class="container">{%- endif -%}
    {%- for block in section.blocks -%}
      <div class="custom-liquid__block" {{ block.shopify_attributes }}>
        {{ block.settings.code }}
      </div>
    {%- endfor -%}
  {%- if section.settings.wrap_in_container -%}</div>{%- endif -%}
</div>

{% stylesheet %}
.custom-liquid__block + .custom-liquid__block { margin-top: 1.6rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Liquid",
  "tag": "section",
  "class": "custom-liquid-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "1", "label": "Scheme 1 — Ivory" },
        { "value": "2", "label": "Scheme 2 — Ink" },
        { "value": "3", "label": "Scheme 3 — Terracotta" },
        { "value": "4", "label": "Scheme 4 — Indigo" },
        { "value": "5", "label": "Scheme 5 — Marigold" },
        { "value": "6", "label": "Scheme 6 — Leaf" }
      ],
      "default": "1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "split", "label": "Split" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "wrap_in_container", "label": "Wrap in the page container", "default": true },
    { "type": "checkbox", "id": "full_width", "label": "Remove the side padding", "default": false }
  ],
  "blocks": [
    {
      "type": "liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "code",
          "label": "Liquid code",
          "default": "<p style=\"text-align:center\">Write any HTML or Liquid here.</p>"
        }
      ]
    }
  ],
  "presets": [
    { "name": "Custom Liquid" }
  ]
}
{% endschema %}
