{%- comment -%}
  Custom Liquid — a free-form block for merchants who want to write their own HTML/Liquid.
{%- endcomment -%}
{%- style -%}
  /* Section spacing — Theme settings › this section */
  #shopify-section-{{ section.id }} {
    --section-pad-top: {{ section.settings.padding_top }}px;
    --section-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}
<div class="custom-liquid section color-scheme-{{ section.settings.color_scheme }}{% if section.settings.full_width %} custom-liquid--flush{% endif %}" data-section-id="{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <div class="container">
      {%- render 'section-header', eyebrow: section.settings.eyebrow, title: section.settings.heading, align: section.settings.header_alignment -%}
    </div>
  {%- endif -%}

  {%- if section.settings.wrap_in_container -%}<div class="container">{%- endif -%}
    {%- for block in section.blocks -%}
      <div class="custom-liquid__block" {{ block.shopify_attributes }}>
        {{ block.settings.code }}
      </div>
    {%- endfor -%}
  {%- if section.settings.wrap_in_container -%}</div>{%- endif -%}
</div>

{% stylesheet %}
.custom-liquid__block + .custom-liquid__block { margin-top: 1.6rem; }
.custom-liquid--flush > .container,
.custom-liquid--flush .custom-liquid__block > .container { max-width: none; padding-inline: clamp(0.75rem, 3vw, 2.5rem); }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Liquid",
  "tag": "section",
  "class": "custom-liquid-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "Scheme 1 — Ivory"
        },
        {
          "value": "2",
          "label": "Scheme 2 — Ink"
        },
        {
          "value": "3",
          "label": "Scheme 3 — Terracotta"
        },
        {
          "value": "4",
          "label": "Scheme 4 — Indigo"
        },
        {
          "value": "5",
          "label": "Scheme 5 — Marigold"
        },
        {
          "value": "6",
          "label": "Scheme 6 — Leaf"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "split",
          "label": "Split"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "wrap_in_container",
      "label": "Wrap in the page container",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Remove the side padding",
      "default": false
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "info": "Matches the global section spacing by default. On mobile this is scaled by the ratio in Theme settings › Layout.",
      "default": 96,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "info": "Matches the global section spacing by default. On mobile this is scaled by the ratio in Theme settings › Layout.",
      "default": 96,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "code",
          "label": "Liquid code",
          "default": "<p style=\"text-align:center\">Write any HTML or Liquid here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Liquid"
    }
  ]
}
{% endschema %}
