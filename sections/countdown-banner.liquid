{%- comment -%}
  Countdown banner — a timed promotion strip with a live countdown.
{%- endcomment -%}
{%- liquid
  assign align = section.settings.text_alignment
  assign target = section.settings.date | strip
-%}
{%- style -%}
  /* Section spacing — Theme settings › this section */
  #shopify-section-{{ section.id }} {
    --section-pad-top: {{ section.settings.padding_top }}px;
    --section-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}
<div class="countdown-banner section color-scheme-{{ section.settings.color_scheme }} countdown-banner--align-{{ align }}{% if section.settings.full_width %} countdown-banner--flush{% endif %}" data-section-id="{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <div class="countdown-banner__bg" aria-hidden="true">
      <img src="{{ section.settings.image | image_url: width: 1600 }}" srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1600 }} 1600w" sizes="100vw" alt="" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
      <span class="countdown-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></span>
    </div>
  {%- endif -%}

  <div class="container">
    <div class="countdown-banner__inner">
      <div class="countdown-banner__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="countdown-banner__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="countdown-banner__text rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>

      {%- if target != blank -%}
        <div class="countdown" data-countdown="{{ target | escape }}" data-finished-text="{{ section.settings.finished_text | escape }}" role="timer" aria-live="off">
          <div class="countdown__cell">
            <span class="countdown__value" data-cd-value="days">00</span>
            <span class="countdown__label">{{ 'sections.countdown.days' | t }}</span>
          </div>
          <div class="countdown__cell">
            <span class="countdown__value" data-cd-value="hours">00</span>
            <span class="countdown__label">{{ 'sections.countdown.hours' | t }}</span>
          </div>
          <div class="countdown__cell">
            <span class="countdown__value" data-cd-value="minutes">00</span>
            <span class="countdown__label">{{ 'sections.countdown.minutes' | t }}</span>
          </div>
          <div class="countdown__cell">
            <span class="countdown__value" data-cd-value="seconds">00</span>
            <span class="countdown__label">{{ 'sections.countdown.seconds' | t }}</span>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="countdown-banner__actions">
          <a class="btn{% if section.settings.button_style == 'outline' %} btn--outline{% endif %}{% if section.settings.button_style == 'ghost' %} btn--ghost{% endif %}" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.countdown-banner { position: relative; overflow: hidden; isolation: isolate; }
.countdown-banner--flush > .container { max-width: none; padding-inline: clamp(0.75rem, 3vw, 2.5rem); }
.countdown-banner__bg { position: absolute; inset: 0; z-index: -1; }
.countdown-banner__bg img { width: 100%; height: 100%; object-fit: cover; }
.countdown-banner__overlay { position: absolute; inset: 0; background: var(--color-ink); }

.countdown-banner__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: clamp(1.4rem, 4vw, 3rem);
  flex-wrap: wrap;
}
.countdown-banner__copy { max-width: 34rem; }
.countdown-banner__heading { font-size: clamp(1.4rem, 1.1rem + 1.6vw, var(--h2)); margin: 0.2rem 0 0.5rem; line-height: 1.18; }
.countdown-banner__text { color: var(--text-muted); margin: 0; }

.countdown { display: flex; gap: clamp(0.5rem, 2vw, 1rem); }
.countdown__cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.2rem;
  min-width: clamp(58px, 9vw, 84px);
  padding: 0.7rem 0.4rem;
  background: var(--bg-card);
  border: var(--border-width) solid var(--border);
  border-radius: var(--card-radius);
}
.countdown__value {
  font-family: var(--font-heading);
  font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.3rem);
  line-height: 1;
  font-variant-numeric: tabular-nums;
  color: var(--accent);
}
.countdown__label {
  font-family: var(--font-eyebrow);
  font-size: 0.6rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-muted);
}
.countdown.is-finished { font-family: var(--font-heading); font-size: 1.1rem; color: var(--text-muted); }

.countdown-banner--align-center .countdown-banner__inner { justify-content: center; text-align: center; }
.countdown-banner--align-center .countdown-banner__copy { margin-inline: auto; }
.countdown-banner--align-right .countdown-banner__inner { flex-direction: row-reverse; text-align: right; }
.countdown-banner--align-right .countdown-banner__copy { margin-inline: auto 0; }

@media (max-width: 749px) {
  .countdown-banner__inner { justify-content: center; text-align: center; }
  .countdown-banner__copy { margin-inline: auto; }
  .countdown-banner__actions { width: 100%; }
  .countdown-banner__actions .btn { width: 100%; }
  .countdown { justify-content: center; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Countdown banner",
  "tag": "section",
  "class": "countdown-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "4",
      "options": [
        {
          "value": "4",
          "label": "Scheme 4 — Indigo"
        },
        {
          "value": "3",
          "label": "Scheme 3 — Terracotta"
        },
        {
          "value": "2",
          "label": "Scheme 2 — Ink"
        },
        {
          "value": "5",
          "label": "Scheme 5 — Marigold"
        },
        {
          "value": "1",
          "label": "Scheme 1 — Ivory"
        },
        {
          "value": "6",
          "label": "Scheme 6 — Leaf"
        }
      ]
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Diwali preview"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The festive collection closes soon"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Once the run is printed, it will not be repeated this year.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Timer"
    },
    {
      "type": "text",
      "id": "date",
      "label": "End date and time",
      "info": "Format: 2026-12-31T23:59 (store time zone)",
      "default": "2026-12-31T23:59"
    },
    {
      "type": "text",
      "id": "finished_text",
      "label": "Text shown when the timer ends"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "default": 55,
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width (edge to edge)",
      "default": true
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "ghost",
          "label": "Text"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "info": "Matches the global section spacing by default. On mobile this is scaled by the ratio in Theme settings › Layout.",
      "default": 96,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "info": "Matches the global section spacing by default. On mobile this is scaled by the ratio in Theme settings › Layout.",
      "default": 96,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Countdown banner"
    }
  ]
}
{% endschema %}
